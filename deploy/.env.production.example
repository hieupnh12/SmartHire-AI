# =============================================================================
# SmartHire-AI — Production env for Google Cloud VPS
# Copy:  cp deploy/.env.production.example deploy/.env.production
# NEVER commit deploy/.env.production
# Generate secrets: openssl rand -base64 48
# =============================================================================

# --- HikariCP / RabbitMQ workers ---
RABBIT_CONCURRENCY=3
RABBIT_MAX_CONCURRENCY=10

# --- Public URLs ---
DOMAIN=example.com
PUBLIC_URL=https://example.com
CORS_ORIGINS=https://example.com
VITE_API_BASE_URL=/api/v1

# --- PostgreSQL master / MySQL tenants ---
MASTER_DB_URL=jdbc:postgresql://postgres:5432/smarthire_master
MASTER_DB_USERNAME=smarthire_master
MASTER_DB_PASSWORD=CHANGE_ME_master_password
MASTER_DB_POOL_SIZE=10
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password
TENANT_MYSQL_BASE_URL=jdbc:mysql://mysql:3306
TENANT_MYSQL_OPTIONS='sslMode=PREFERRED&allowPublicKeyRetrieval=true'
TENANT_PROVISIONING_URL=jdbc:mysql://mysql:3306/?allowPublicKeyRetrieval=true
TENANT_PROVISIONING_USERNAME=smarthire_provisioner
# Generate a hex password: openssl rand -hex 24
TENANT_PROVISIONING_PASSWORD=CHANGE_ME_HEX_PASSWORD
# Generate exactly 32 random bytes: openssl rand -base64 32
TENANT_CREDENTIALS_KEY=CHANGE_ME_BASE64_32_BYTES
TENANT_BASE_DOMAIN=example.com
TENANT_DB_POOL_SIZE=5
TENANT_MAX_POOLS=20
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis_password

# --- RabbitMQ ---
RABBITMQ_USER=smarthire
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password

# --- JWT / OAuth ---
JWT_SECRET=CHANGE_ME_use_openssl_rand_base64_48
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- App ---
SWAGGER_ENABLED=true
SPRING_PROFILES_ACTIVE=prod

# --- Deploy ---
DEPLOY_PATH=/opt/smarthire
GCP_ZONE=asia-southeast1-a
GCP_INSTANCE_NAME=smarthire-vps
GCP_PROJECT_ID=your-gcp-project-id
