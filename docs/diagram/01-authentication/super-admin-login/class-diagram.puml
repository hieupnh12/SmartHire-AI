@startuml
skinparam dpi 300
skinparam shadowing false
skinparam packageStyle rectangle
skinparam roundcorner 6
skinparam linetype ortho
skinparam defaultFontName "Arial"
skinparam defaultFontSize 11
skinparam classFontSize 11
skinparam classAttributeFontSize 10

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #2D3748
    ArrowColor #2D3748
}

package "Controller Layer" {
  class MasterAuthController <<Controller>> {
    - masterAuthService: MasterAuthService
    + login(request: MasterLoginRequest): ResponseEntity<ApiResponse<MasterLoginResponse>>
    + getCurrentAdmin(authHeader: String): ResponseEntity<ApiResponse<PlatformUserResponse>>
  }
}

package "DTO Layer" {
  class MasterLoginRequest <<Request>> {
    + email: String
    + password: String
  }

  class MasterLoginResponse <<Response>> {
    + accessToken: String
    + tokenType: String
    + user: PlatformUserResponse
    + tenantId: String
  }

  class PlatformUserResponse <<Response>> {
    + id: Long
    + email: String
    + fullName: String
    + role: String
    + status: String
  }
}

package "Service Layer" {
  class MasterAuthService <<Service>> {
    - platformUserRepository: PlatformUserRepository
    - passwordEncoder: PasswordEncoder
    - tokenProvider: JwtTokenProvider
    + login(request: MasterLoginRequest): MasterLoginResponse
    + getCurrentAdmin(authHeader: String): PlatformUserResponse
  }

  class JwtTokenProvider <<Security>> {
    + generateToken(userId: Long, email: String, role: String, tenantId: String): String
    + validateToken(token: String): boolean
    + getUsernameFromJwt(token: String): String
  }

  interface PasswordEncoder <<Security>> {
    + matches(rawPassword: CharSequence, encodedPassword: String): boolean
    + encode(rawPassword: CharSequence): String
  }
}

package "Repository Layer" {
  interface PlatformUserRepository <<Repository>> {
    + findByEmailIgnoreCase(email: String): Optional<PlatformUser>
    + save(user: PlatformUser): PlatformUser
  }
}

package "Domain Entity Layer" {
  class PlatformUser <<Entity>> {
    - id: Long
    - email: String
    - passwordHash: String
    - fullName: String
    - role: String
    - status: String
    - createdAt: LocalDateTime
    - updatedAt: LocalDateTime
  }
}

package "Infrastructure & Persistence" {
  class "Master PostgreSQL\n(platform_users)" as MasterDB <<Database>>
}

' Relationships & Navigation
MasterAuthController --> MasterAuthService : delegates >
MasterAuthController ..> MasterLoginRequest : consumes >
MasterAuthController ..> MasterLoginResponse : returns >
MasterLoginResponse *-- PlatformUserResponse : contains >

MasterAuthService ..> MasterLoginRequest : processes >
MasterAuthService ..> MasterLoginResponse : creates >
MasterAuthService --> PlatformUserRepository : queries / manages >
MasterAuthService --> PasswordEncoder : verifies password >
MasterAuthService --> JwtTokenProvider : generates token >

PlatformUserRepository --> PlatformUser : manages >
PlatformUserRepository --> MasterDB : persists to / reads from >
MasterDB *-- PlatformUser : stores >

note bottom of MasterAuthService
  Architecture Invariant:
  Super Admin operates strictly on Master DB.
  No X-Tenant-ID header or TenantContext is required.
end note

@enduml
