@startuml
title AUTH-02 - Đăng nhập tài khoản doanh nghiệp bằng email/password

autonumber
hide footbox
skinparam responseMessageBelowArrow true
skinparam sequenceMessageAlign center

actor "Người dùng" as User
boundary "Ứng dụng React" as FE
control "TenantWebInterceptor" as TenantInterceptor
control "AuthController" as Controller
control "AuthService" as AuthService
database "Master DB\n(Tenant Registry)" as MasterDB
control "TenantContext" as TenantContext
database "Tenant DB\n(users)" as TenantDB
collections "Redis" as Redis
control "JwtService" as JwtService

User -> FE: Nhập tenant, email và password
FE -> TenantInterceptor: POST /api/v1/tenant/auth/login\nX-Tenant-ID + credentials
TenantInterceptor -> MasterDB: Tìm tenant theo mã/subdomain
MasterDB --> TenantInterceptor: Thông tin và trạng thái tenant

alt Tenant không tồn tại hoặc không ACTIVE
    TenantInterceptor --> FE: 401 Unauthorized\n"Thông tin đăng nhập không hợp lệ"
    FE --> User: Hiển thị lỗi chung
else Tenant hợp lệ
    TenantInterceptor -> TenantContext: setCurrentTenant(tenantId)
    TenantInterceptor -> Controller: Chuyển tiếp LoginRequest
    Controller -> AuthService: login(email, password)
    AuthService -> Redis: Kiểm tra rate limit

    alt Vượt giới hạn đăng nhập
        Redis --> AuthService: Bị giới hạn
        AuthService --> Controller: TooManyRequestsException
        Controller --> FE: 429 Too Many Requests
        FE --> User: Yêu cầu thử lại sau
    else Được phép đăng nhập
        Redis --> AuthService: Cho phép
        AuthService -> TenantDB: Tìm user theo email
        TenantDB --> AuthService: User hoặc không tìm thấy
        AuthService -> AuthService: Kiểm tra password và trạng thái user

        alt Sai thông tin hoặc tài khoản bị khóa
            AuthService -> Redis: Ghi nhận lần đăng nhập thất bại
            AuthService --> Controller: InvalidCredentialsException
            Controller --> FE: 401 Unauthorized\n"Thông tin đăng nhập không hợp lệ"
            FE --> User: Hiển thị lỗi chung
        else Xác thực thành công
            AuthService -> JwtService: Tạo access token và refresh token\n(userId, role, tenantId)
            JwtService --> AuthService: Token pair
            AuthService -> Redis: Lưu refresh session có TTL
            AuthService -> Redis: Xóa số lần đăng nhập thất bại
            AuthService --> Controller: LoginResponse
            Controller --> FE: 200 OK\naccessToken + refreshToken + user
            FE -> FE: Lưu phiên đăng nhập an toàn\nCấu hình Bearer + X-Tenant-ID
            FE --> User: Điều hướng theo role
        end
    end

    TenantInterceptor -> TenantContext: clear()
end

note over TenantInterceptor,TenantContext
TenantContext phải được xóa sau request,
kể cả khi xảy ra exception, để tránh rò rỉ tenant.
end note

@enduml
