@startuml
!include ../sequence-style.puml
actor Recruiter
boundary "Tenant Web" as Web
control "TenantWebInterceptor" as Interceptor
control "JobController" as Controller
control "JobDeletionServiceImpl" as Service
entity "JobRepository" as JobRepo
entity "ApplicationRepository" as AppRepo
database "Tenant DB" as DB
queue "job.events" as Events

Recruiter -> Web: 1. Confirm job deletion
Web -> Interceptor: 2. DELETE /api/v1/jobs/{id}
activate Interceptor
Interceptor -> Interceptor: 3. Authenticate, authorize, set tenant
Interceptor -> Controller: 4. delete(id)
activate Controller
Controller -> Service: 5. delete(id, principal)
activate Service
Service -> JobRepo: 6. findAuthorized(id, principal)
JobRepo -> DB: 7. SELECT job
DB --> JobRepo: 8. Job or empty
alt Missing or inaccessible
  Service --> Controller: 9a. NotFound
  Controller --> Web: 10a. 404
else Job found
  Service -> AppRepo: 9b. existsByJobId(id)
  AppRepo -> DB: 10b. Check application references
  DB --> AppRepo: 11. Exists flag
  alt Has applications
    Service -> JobRepo: 12a. save(job.archive())
    JobRepo -> DB: 13a. UPDATE status=ARCHIVED, deleted_at
  else No applications and deletion policy allows
    Service -> JobRepo: 12b. delete(job)
    JobRepo -> DB: 13b. DELETE job
  end
  Service -> Events: 14. Publish deletion mode + tenant header
  Service --> Controller: 15. Success
  Controller --> Web: 16. 204 No Content
end
deactivate Service
deactivate Controller
Interceptor -> Interceptor: 17. Clear TenantContext in finally
deactivate Interceptor
Web --> Recruiter: 18. Remove row or show error
@enduml

