@startuml
!include ../class-style.puml
package "Controller Layer" #EEF6FF {
  class JobQueryController <<Controller>> {
    - jobQueryService: JobQueryService
    + search(filter: JobSearchRequest): ApiResponse<Page<JobListItemResponse>>
    + getDetail(id: Long): ApiResponse<JobDetailResponse>
  }
}
package "DTO Layer" #FFF8EF {
  class JobSearchRequest <<Request>> {
    + keyword: String
    + statuses: Set<JobStatus>
    + departmentId: Long
    + recruiterId: Long
    + page: int
    + size: int
  }
  class JobListItemResponse <<Response>> {
    + id: Long
    + title: String
    + status: JobStatus
    + applicationCount: long
  }
  class JobDetailResponse <<Response>> {
    + id: Long
    + title: String
    + description: String
    + applicationSummary: JobApplicationSummary
  }
  class JobApplicationSummary <<DTO>> {
    + total: long
    + active: long
  }
}
package "Service Layer" #EFFBF4 {
  interface JobQueryService <<Service>> {
    + search(filter: JobSearchRequest, principal: Principal): Page<JobListItemResponse>
    + getDetail(id: Long, principal: Principal): JobDetailResponse
  }
  class JobQueryServiceImpl <<Service>> {
    - jobQueryRepository: JobQueryRepository
    + search(filter: JobSearchRequest, principal: Principal): Page<JobListItemResponse>
    + getDetail(id: Long, principal: Principal): JobDetailResponse
  }
}
package "Repository Layer" #F5F3FF {
  interface JobQueryRepository <<Repository>> {
    + search(filter: JobSearchRequest, scope: JobAccessScope): Page<JobProjection>
    + findDetail(id: Long, scope: JobAccessScope): Optional<JobProjection>
  }
}
package "Domain Entity Layer" #F0FBF5 {
  class Job <<Entity>> {
    - id: Long
    - title: String
    - status: JobStatus
  }
  class Application <<Entity>> {
    - id: Long
    - status: ApplicationStatus
  }
  enum JobStatus <<Enum>> {
    DRAFT
    PUBLISHED
    PAUSED
    CLOSED
    ARCHIVED
  }
}
package "Infrastructure & Persistence" #FFFCEE {
  class TenantContext <<ThreadLocal>> {
    + getCurrentTenant(): String
  }
  class "Dedicated Tenant MySQL DB" as TenantDb <<Database>> {
    + jobs
    + applications
  }
}
JobQueryController --> JobQueryService : delegates >
JobQueryController ..> JobSearchRequest : consumes >
JobQueryController ..> JobListItemResponse : returns >
JobQueryController ..> JobDetailResponse : returns >
JobQueryServiceImpl ..|> JobQueryService : implements
JobQueryServiceImpl --> JobQueryRepository : queries >
JobQueryServiceImpl --> TenantContext : enforces tenant scope >
JobQueryRepository --> Job : reads >
JobQueryRepository --> Application : aggregates >
Job "1" <-- "0..*" Application : receives
Job --> JobStatus : typed by >
JobQueryRepository --> TenantDb : reads from >
@enduml
