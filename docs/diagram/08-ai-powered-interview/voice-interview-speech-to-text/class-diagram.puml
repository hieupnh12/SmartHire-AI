@startuml
title FE08-F02 — Voice Interview & Speech-to-Text\nLayered target application-design viewpoint
top to bottom direction
skinparam dpi 300
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 12
skinparam linetype ortho
skinparam ArrowColor #334155
skinparam ArrowThickness 1
skinparam ClassBorderColor #64748B
skinparam ClassBorderThickness 1
skinparam ClassBackgroundColor #F8FAFC
skinparam InterfaceBackgroundColor #F3E8FF
skinparam PackageBorderColor #475569
skinparam PackageBorderThickness 1
skinparam DefaultFontColor #111827
skinparam ClassFontColor #111827
skinparam ClassAttributeFontColor #111827

package "Routing & Boundary" #EFF6FF {
  class InterviewVoiceRoute <<REST API, conceptual>> {
    +POST /api/v1/interviews/{id}/voice
  }
}

package "Controller Layer" #EFF6FF {
  class InterviewController <<Controller>> {
    -interviewService: InterviewService
    +submitVoiceAnswer(interviewId: Long, request: VoiceAnswerRequest): ApiResponse<VoiceAcceptedResponse>
  }
}

package "Service Layer" #F0FDF4 {
  class InterviewService <<Service>> {
    -interviewRepository: InterviewRepository
    -answerRepository: InterviewAnswerRepository
    -objectStorage: ObjectStoragePort
    -sttPublisher: InterviewSttPublisher
    -tenantContext: TenantContext
    +submitVoiceAnswer(interviewId: Long, request: VoiceAnswerRequest, principal: Principal): VoiceAcceptedResponse
  }
  class InterviewSttService <<Service>> {
    -answerRepository: InterviewAnswerRepository
    -sttPort: SpeechToTextPort
    -tenantContext: TenantContext
    +transcribe(job: SttJob): InterviewAnswer
  }
  class InterviewSttConsumer <<RabbitMQ Consumer>> {
    -sttService: InterviewSttService
    +onSttRequested(job: SttJob, tenantId: String): void
  }
}

package "DTO Layer" #FFF7ED {
  class VoiceAnswerRequest <<Request>> {
    +questionId: Long
    +audio: MultipartFile
    +language: String
  }
  class VoiceAcceptedResponse <<Response>> {
    +interviewId: Long
    +questionId: Long
    +answerId: Long
    +status: String
    +accepted: boolean
  }
  class SttJob <<Message>> {
    +interviewId: Long
    +answerId: Long
    +language: String
    +correlationId: String
  }
}

package "Repository Layer" #F5F3FF {
  interface InterviewRepository <<Repository>> {
    +findById(id: Long): Optional<Interview>
  }
  interface InterviewAnswerRepository <<Repository>> {
    +findById(id: Long): Optional<InterviewAnswer>
    +save(answer: InterviewAnswer): InterviewAnswer
  }
}

package "Domain Entity Layer" #F0FDF4 {
  entity Interview <<Entity>> {
    -id: Long
    -status: InterviewStatus
  }
  entity InterviewQuestion <<Entity>> {
    -id: Long
    -sortOrder: int
    -questionText: String
  }
  entity InterviewAnswer <<Entity>> {
    -id: Long
    -audioUrl: String
    -transcript: String [0..1]
    -status: String
  }
  enum InterviewStatus <<Enumeration>> {
    QUESTIONS_READY
    IN_PROGRESS
    SCORING
    SCORED
    FAILED
  }
}

package "Infrastructure & Persistence" #FEFCE8 {
  interface ObjectStoragePort <<Storage Port>> {
    +storeAudio(tenantId: String, interviewId: Long, file: MultipartFile): String
  }
  interface SpeechToTextPort <<STT Port>> {
    +transcribe(audioUrl: String, language: String): String
  }
  class InterviewSttPublisher <<Publisher>> {
    +publish(job: SttJob, tenantId: String): void
  }
  class "Dedicated Tenant MySQL DB" as TenantDB <<Database>> {
    +interviews
    +interview_questions
    +interview_answers
  }
  class "RabbitMQ\ninterview.stt" as SttQueue <<Message Broker>>
  class TenantContext <<ThreadLocal>> {
    +{static} getCurrentTenant(): String
    +{static} setCurrentTenant(tenantId: String): void
    +{static} clear(): void
  }
}

InterviewVoiceRoute -down-> InterviewController : defines routes
InterviewController -down-> InterviewService : delegates
InterviewController ..> VoiceAnswerRequest : consumes
InterviewController ..> VoiceAcceptedResponse : returns
InterviewService ..> VoiceAnswerRequest : processes
InterviewService ..> VoiceAcceptedResponse : creates
InterviewService ..> SttJob : emits
InterviewService --> ObjectStoragePort : stores audio
InterviewService --> InterviewRepository : validates session
InterviewService --> InterviewAnswerRepository : creates answer
InterviewService --> InterviewSttPublisher : publishes
InterviewService --> TenantContext : enforces tenant scope

InterviewSttPublisher --> SttQueue : sends with X-Tenant-ID
SttQueue --> InterviewSttConsumer : delivers
InterviewSttConsumer --> InterviewSttService : processes
InterviewSttConsumer --> TenantContext : restores / clears
InterviewSttService --> SpeechToTextPort : calls STT
InterviewSttService --> InterviewAnswerRepository : updates transcript
InterviewSttService ..> SttJob : processes

InterviewRepository -down-> Interview : manages
InterviewAnswerRepository -down-> InterviewAnswer : manages
Interview "1" *-- "1..*" InterviewQuestion : contains
InterviewQuestion "1" *-- "0..1" InterviewAnswer : answered by
Interview ..> InterviewStatus : has status

Interview --> TenantDB : persists to
InterviewQuestion --> TenantDB : persists to
InterviewAnswer --> TenantDB : persists to

VoiceAnswerRequest -[hidden]right-> VoiceAcceptedResponse
VoiceAcceptedResponse -[hidden]right-> SttJob
InterviewQuestion -[hidden]right-> InterviewAnswer
SttQueue -[hidden]right-> TenantContext

note right of InterviewService
  Scope I: one audio upload per question.
  Saves audio_url immediately with status
  RECORDED / TRANSCRIBING, then enqueues STT.
  Realtime streaming is out of scope.
end note

note right of InterviewSttService
  Writes transcript only. NLP analysis and
  scoring continue in FE07-F02 after answers
  are ready (choice A).
end note
@enduml
