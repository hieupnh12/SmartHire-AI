@startuml
title FE13-F03 — Export Recruitment Analytics\nLayered target application-design viewpoint
top to bottom direction
skinparam dpi 300
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 12
skinparam linetype ortho
skinparam ArrowColor #334155
skinparam ArrowThickness 1
skinparam ClassBorderColor #64748B
skinparam ClassBorderThickness 1
skinparam ClassBackgroundColor #F8FAFC
skinparam InterfaceBackgroundColor #F3E8FF
skinparam PackageBorderColor #475569
skinparam PackageBorderThickness 1
skinparam DefaultFontColor #111827
skinparam ClassFontColor #111827
skinparam ClassAttributeFontColor #111827

package "Routing & Boundary" #EFF6FF {
  class AnalyticsExportRoute <<REST API, conceptual>> {
    +POST /api/v1/dashboard/exports
    +GET /api/v1/dashboard/exports/{id}
  }
}
package "Controller Layer" #EFF6FF {
  class AnalyticsExportController <<Controller>> {
    -exportService: AnalyticsExportService
    +createExport(request: ExportAnalyticsRequest): ApiResponse<ExportJobResponse>
    +getExport(id: UUID): ApiResponse<ExportJobResponse>
  }
}
package "Service Layer" #F0FDF4 {
  interface AnalyticsExportService <<Service>> {
    +requestExport(request: ExportAnalyticsRequest, principal: Principal): ExportJobResponse
    +getExport(id: UUID, principal: Principal): ExportJobResponse
  }
  class AnalyticsExportServiceImpl <<Service>> {
    -exportJobRepository: ExportJobRepository
    -exportPublisher: AnalyticsExportPublisher
    -tenantContext: TenantContext
    +requestExport(request: ExportAnalyticsRequest, principal: Principal): ExportJobResponse
    +getExport(id: UUID, principal: Principal): ExportJobResponse
  }
}
package "DTO Layer" #FFF7ED {
  class ExportAnalyticsRequest <<Request>> {
    +format: ExportFormat
    +from: LocalDate
    +to: LocalDate
    +timezone: ZoneId
    +metricVersion: String
    +reportSections: Set<ReportSection>
  }
  class ExportJobResponse <<Response>> {
    +id: UUID
    +status: ExportStatus
    +downloadUrl: URI [0..1]
    +expiresAt: Instant [0..1]
  }
  class AnalyticsExportMessage <<Domain Event>> {
    +tenantId: String
    +exportJobId: UUID
    +correlationId: String
  }
}
package "Repository Layer" #F5F3FF {
  interface ExportJobRepository <<Repository>> {
    +save(job: AnalyticsExportJob): AnalyticsExportJob
    +findAuthorized(id: UUID): Optional<AnalyticsExportJob>
  }
}
package "Domain Entity Layer" #F0FDF4 {
  entity AnalyticsExportJob <<Entity>> {
    -id: UUID
    -requestedBy: Long
    -format: ExportFormat
    -metricVersion: String
    -status: ExportStatus
    -objectKey: String [0..1]
    -expiresAt: Instant [0..1]
  }
  enum ExportFormat <<Enum>> {
    CSV
    PDF
  }
  enum ExportStatus <<Enum>> {
    QUEUED
    PROCESSING
    READY
    FAILED
    EXPIRED
  }
}
package "Infrastructure & Persistence" #FEFCE8 {
  class AnalyticsExportPublisher <<Message Publisher>> {
    +publish(message: AnalyticsExportMessage, tenantId: String): void
  }
  class ExportWorker <<Rabbit Listener>> {
    +generate(message: AnalyticsExportMessage): void
  }
  class "RabbitMQ analytics-export.queue" as Queue <<Message Broker>>
  class "Dedicated Tenant MySQL DB" as TenantDB <<Database>> {
    +analytics_export_jobs
  }
  class "Private Object Storage" as Storage <<Object Storage>> {
    +tenant/{tenantId}/analytics-exports/{jobId}
  }
  class TenantContext <<ThreadLocal>> {
    +{static} getCurrentTenant(): String
  }
}

AnalyticsExportRoute -down-> AnalyticsExportController : defines routes
AnalyticsExportController -down-> AnalyticsExportService : delegates
AnalyticsExportService -[hidden]down-> AnalyticsExportServiceImpl
AnalyticsExportServiceImpl ..up|> AnalyticsExportService : implements
AnalyticsExportController ..> ExportAnalyticsRequest : consumes
AnalyticsExportController ..> ExportJobResponse : returns
AnalyticsExportServiceImpl ..> ExportAnalyticsRequest : processes
AnalyticsExportServiceImpl ..> ExportJobResponse : creates
AnalyticsExportServiceImpl ..> AnalyticsExportMessage : emits
AnalyticsExportServiceImpl -down-> ExportJobRepository : creates / reads job
AnalyticsExportServiceImpl --> AnalyticsExportPublisher : publishes task
AnalyticsExportServiceImpl --> TenantContext : enforces tenant scope
ExportJobRepository -down-> AnalyticsExportJob : manages
AnalyticsExportJob --> ExportFormat : typed by
AnalyticsExportJob --> ExportStatus : has status
AnalyticsExportJob --> TenantDB : persists to
AnalyticsExportPublisher --> Queue : tenant header + event
Queue --> ExportWorker : delivers
ExportWorker --> TenantContext : restores / clears
ExportWorker --> TenantDB : loads analytics snapshot
ExportWorker --> Storage : writes encrypted CSV / PDF
ExportAnalyticsRequest -[hidden]right-> ExportJobResponse
ExportJobResponse -[hidden]right-> AnalyticsExportMessage
ExportFormat -[hidden]right-> ExportStatus
TenantDB -[hidden]right-> Queue
Queue -[hidden]right-> Storage
Storage -[hidden]right-> TenantContext
note right of AnalyticsExportServiceImpl
  Captures an immutable filter, timezone and metric-version snapshot.
  Export processing is asynchronous and idempotent.
end note
@enduml
