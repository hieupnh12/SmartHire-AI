@startuml
top to bottom direction

skinparam dpi 300
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam roundcorner 6
skinparam defaultFontName "Arial"
skinparam defaultFontSize 11
skinparam classFontSize 11
skinparam classAttributeFontSize 10
skinparam classAttributeIconSize 10
skinparam linetype ortho
skinparam ArrowColor #334155
skinparam ArrowThickness 1
skinparam ClassBorderColor #2D3748
skinparam ClassBorderThickness 1
skinparam ClassBackgroundColor #FFFFFF
skinparam InterfaceBackgroundColor #FFFFFF
skinparam PackageBorderColor #2D3748
skinparam PackageBorderThickness 1
skinparam DefaultFontColor #111827
skinparam ClassFontColor #111827
skinparam ClassAttributeFontColor #111827

<style>
classDiagram {
  class { Padding 5 }
}
</style>

package "Controller Layer" #F7FAFC {
  class DrillDownController <<Controller>> {
    -drillDownService: DrillDownService
    +getDetails(request: DrillDownRequest): ApiResponse<Page<DrillDownRow>>
  }
}

package "Service Layer" #F0FDF4 {
  interface DrillDownService <<Service>> {
    +getDetails(request: DrillDownRequest, principal: Principal): Page<DrillDownRow>
  }

  class DrillDownServiceImpl <<Service>> {
    -drillDownRepository: DrillDownRepository
    -tenantContext: TenantContext
    +getDetails(request: DrillDownRequest, principal: Principal): Page<DrillDownRow>
  }
}

package "DTO Layer" #FFF7ED {
  class DrillDownRequest <<Request>> {
    +metricCode: String
    +dimension: String
    +dimensionValue: String
    +from: LocalDate
    +to: LocalDate
    +timezone: ZoneId
    +metricVersion: String
    +page: int
    +size: int
  }

  class DrillDownRow <<Response>> {
    +jobId: Long
    +jobTitle: String
    +applicationId: Long [0..1]
    +candidateDisplayName: String [0..1]
    +stage: String [0..1]
    +occurredAt: OffsetDateTime
    +value: Decimal [0..1]
  }
}

package "Repository Layer" #F5F3FF {
  interface DrillDownRepository <<Repository>> {
    +findDetails(request: DrillDownRequest, allowedJobIds: Set<Long>): Page<Application>
  }
}

package "Domain Entity Layer" #F0FDF4 {
  entity Application <<Entity>> {
    -id: Long
    -status: ApplicationStatus
    -source: String
    -createdAt: Instant
    +getStage(): RecruitmentStage
  }

  entity Job <<Entity>> {
    -id: Long
    -title: String
    -status: JobStatus
  }

  entity RecruitmentStage <<Entity>> {
    -id: Long
    -name: String
    -sortOrder: int
  }
}

package "Infrastructure & Persistence" #FEFCE8 {
  class "Dedicated Tenant MySQL DB" as TenantDB <<Database>> {
    +jobs
    +applications
    +recruitment_stages
    +application_status_history
  }

  class TenantContext <<ThreadLocal>> {
    +{static} getCurrentTenant(): String
  }
}

DrillDownController -down-> DrillDownService : delegates >
DrillDownService -[hidden]down-> DrillDownServiceImpl
DrillDownServiceImpl ..up|> DrillDownService : implements

DrillDownController ..> DrillDownRequest : consumes >
DrillDownController ..> DrillDownRow : returns >
DrillDownServiceImpl ..> DrillDownRequest : processes >
DrillDownServiceImpl ..> DrillDownRow : creates >
DrillDownServiceImpl -down-> DrillDownRepository : queries >
DrillDownServiceImpl --> TenantContext : reads tenant scope >

DrillDownRepository -down-> Application : manages >
Application "0..*" --> "1" Job : belongs to
Application "0..*" --> "0..1" RecruitmentStage : currently at
DrillDownRepository --> TenantDB : reads from >

DrillDownRequest -[hidden]right-> DrillDownRow
Job -[hidden]right-> RecruitmentStage
TenantDB -[hidden]right-> TenantContext

note right of DrillDownServiceImpl
  Reuses the dashboard filter, timezone and metric version.
  Applies role scope and masks candidate PII before returning rows.
end note
@enduml
