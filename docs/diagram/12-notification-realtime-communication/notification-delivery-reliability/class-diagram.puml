@startuml
title NOTIFY — Notification Delivery and Reliability\nLayered target application-design viewpoint
top to bottom direction

skinparam dpi 300
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 12
skinparam linetype ortho
skinparam ArrowColor #334155
skinparam ArrowThickness 1
skinparam ClassBorderColor #64748B
skinparam ClassBorderThickness 1
skinparam ClassBackgroundColor #F8FAFC
skinparam InterfaceBackgroundColor #F3E8FF
skinparam PackageBorderColor #475569
skinparam PackageBorderThickness 1
skinparam DefaultFontColor #111827
skinparam ClassFontColor #111827
skinparam ClassAttributeFontColor #111827
skinparam NoteBackgroundColor #FFF7ED
skinparam NoteBorderColor #FDBA74

package "Service Layer" #F0FDF4 {
  class EmailWorker <<Service, conceptual>> {
    -emailOutboxRepository: EmailOutboxRepository
    -tenantContext: TenantContext
    +onNotifyEmail(payload: String, tenantId: String): void
  }
}

package "Repository Layer" #F5F3FF {
  interface EmailOutboxRepository <<Repository>> {
    +findByIdempotencyKey(key: String): Optional<EmailOutbox>
    +save(row: EmailOutbox): EmailOutbox
  }
}

package "Domain Entity Layer" #F0FDF4 {
  entity EmailOutbox <<Entity>> {
    -id: Long
    -toEmail: String
    -status: NotificationStatus
    -attempts: int
    -idempotencyKey: String
    -sentAt: Instant [0..1]
  }
  entity Notification <<Entity>> {
    -id: Long
    -userId: Long
    -type: String
    -sourceEventId: String
  }
  enum NotificationStatus <<enumeration>> {
    PENDING
    SENT
    FAILED
  }
}

package "Infrastructure & Persistence" #FEFCE8 {
  class "RabbitMQ notify.email" as NotifyBroker <<Message Broker>> {
    +notify.email.q
  }
  class "notify.email.dlq" as Dlq <<Message Broker, conceptual>>
  class "SMTP provider" as Smtp <<External>>
  class "Dedicated Tenant MySQL DB" as TenantDB <<Database>> {
    +email_outbox
    +notifications
  }
  class TenantContext <<ThreadLocal>> {
    +{static} getCurrentTenant(): String
    +{static} clear(): void
  }
}

EmailWorker ..> NotifyBroker : consumes / nacks
EmailWorker -down-> EmailOutboxRepository : persists through
EmailWorker --> TenantContext : restores tenant from header
EmailWorker --> Smtp : sends
EmailWorker --> Dlq : routes after max attempts
EmailOutboxRepository -down-> EmailOutbox : manages
EmailOutbox --> NotificationStatus : typed by
EmailOutbox --> TenantDB : persists to
Notification --> TenantDB : persists to
Notification ..> EmailOutbox : same sourceEventId

NotifyBroker -[hidden]right-> Dlq
Dlq -[hidden]right-> Smtp
Smtp -[hidden]right-> TenantDB
TenantDB -[hidden]right-> TenantContext
EmailOutbox -[hidden]right-> Notification

note right of EmailWorker
  Designed maxAttempts = 3.
  Duplicate SENT idempotencyKey is acked without a second SMTP send.
  Inbox insert uses the same sourceEventId to avoid a second row.
end note

note right of EmailOutbox
  Flyway today: status, attempts, sent_at.
  idempotencyKey is designed (unique per tenant DB).
  RabbitMqConfig has no DLQ binding yet.
end note

@enduml
