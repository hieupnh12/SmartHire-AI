@startuml
skinparam dpi 300
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName "Arial"
skinparam defaultFontSize 11
skinparam sequence {
    ArrowColor #2D3748
    ActorBorderColor #2D3748
    LifeLineBorderColor #2D3748
    ParticipantBorderColor #2D3748
    ParticipantBackgroundColor #FFFFFF
    BoxBorderColor #A0AEC0
}

hide footbox
autonumber

queue "Primary Queue (notify.email.q)" as MainQueue
control "EmailConsumerWorker" as Consumer
queue "Dead Letter Exchange (notify.dlx)" as DLX
queue "Dead Letter Queue (notify.dlq)" as DLQ
control "DLQConsumerWorker" as DLQWorker
control "NotificationReliabilityService" as Service
database "Tenant DB (MySQL)" as TenantDB
control "RetryScheduler" as Scheduler

note over MainQueue, Scheduler
  Ensures zero notification loss via Dead Letter Queue & Exponential Backoff Retry.
end note

== Consumer Failure & DLQ Routing ==

MainQueue -> Consumer: Deliver message (x-retry-count)
activate Consumer
Consumer -> Consumer: Attempt execution & fail (e.g. SMTP Timeout / Network Error)

alt Max retries exceeded (e.g. 3 attempts)
  Consumer -> DLX: NACK (requeue = false)
  deactivate Consumer
  activate DLX
  DLX -> DLQ: Route message to Dead Letter Queue
  deactivate DLX
  activate DLQ
end

== Dead Letter Persistence & Retry Scheduler ==

DLQ -> DLQWorker: Consume failed message
deactivate DLQ
activate DLQWorker
DLQWorker -> DLQWorker: TenantContext.setCurrentTenant(tenantId)

DLQWorker -> Service: handleDeadLetterMessage(failedMessage)
activate Service
Service -> TenantDB: INSERT dead_letter_notifications (status = PENDING_RETRY)
activate TenantDB
TenantDB --> Service: DeadLetter saved
deactivate TenantDB

Service --> DLQWorker: Processed
deactivate Service
DLQWorker -> DLQWorker: TenantContext.clear()
deactivate DLQWorker

== Scheduled Auto-Retry Execution ==

Scheduler -> Service: processFailedMessages() (Cron job every 15 min)
activate Service
Service -> TenantDB: findByStatusAndRetryCountLessThan(PENDING_RETRY, 5)
activate TenantDB
TenantDB --> Service: List<DeadLetterNotification>
deactivate TenantDB

loop For each failed notification
  Service -> MainQueue: Re-publish message to primary queue
  activate MainQueue
  MainQueue --> Service: Accepted
  deactivate MainQueue

  alt Re-publish Successful
    Service -> TenantDB: UPDATE dead_letter_notifications status = RESOLVED
    activate TenantDB
    TenantDB --> Service: Status updated
    deactivate TenantDB
  else Exceeded max DLQ retries
    Service -> TenantDB: UPDATE dead_letter_notifications status = ABANDONED
    activate TenantDB
    TenantDB --> Service: Status updated
    deactivate TenantDB
  end
end

deactivate Service

@enduml
