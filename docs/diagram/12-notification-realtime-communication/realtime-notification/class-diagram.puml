@startuml
skinparam dpi 300
skinparam shadowing false
skinparam packageStyle rectangle
skinparam roundcorner 6
skinparam linetype ortho
skinparam defaultFontName "Arial"
skinparam defaultFontSize 11
skinparam classFontSize 11
skinparam classAttributeFontSize 10
skinparam classAttributeIconSize 10
skinparam ArrowThickness 1
skinparam ClassBorderThickness 1
skinparam PackageBorderThickness 1

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #2D3748
    ArrowColor #2D3748
}

<style>
classDiagram {
  class {
    Padding 5
  }
}
</style>

package "Controller Layer" {
  class WebSocketNotificationController <<Controller>> {
    - messagingTemplate: SimpMessagingTemplate
    + handleWebSocketConnect(): void
  }
}

package "DTO Layer" {
  class RealtimeNotificationPayload <<DTO>> {
    + tenantId: String
    + recipientId: Long
    + title: String
    + content: String
    + type: String
    + targetUrl: String
    + timestamp: Instant
  }
}

package "Service Layer" {
  interface RealtimeNotificationService <<Service>> {
    + pushNotificationToUser(recipientId: Long, payload: RealtimeNotificationPayload): void
  }
  class RealtimeNotificationServiceImpl <<Service>> {
    - messagingTemplate: SimpMessagingTemplate
    - redisService: RedisService
    + pushNotificationToUser(recipientId: Long, payload: RealtimeNotificationPayload): void
  }
}

package "Infrastructure & Persistence" {
  class SimpMessagingTemplate <<Framework Port>> {
    + convertAndSendToUser(user: String, destination: String, payload: Object): void
  }
  class WebSocketSTOMPBroker <<Message Broker>> {
    + /topic/tenant.{tenantId}.user.{userId}
  }
  class RedisCache <<Cache>> {
    + tenant:{tenantId}:ws_session:{userId}
  }
  class TenantContext <<ThreadLocal>> {
    +{static} getCurrentTenant(): String
    +{static} clear(): void
  }
}

' Relationships
WebSocketNotificationController --> RealtimeNotificationService : delegates >
RealtimeNotificationService <|.. RealtimeNotificationServiceImpl : implements
RealtimeNotificationServiceImpl ..> RealtimeNotificationPayload : consumes >
RealtimeNotificationServiceImpl --> SimpMessagingTemplate : pushes STOMP message >
RealtimeNotificationServiceImpl --> RedisCache : checks online status >
RealtimeNotificationServiceImpl ..> TenantContext : reads tenant context >

SimpMessagingTemplate --> WebSocketSTOMPBroker : sends to topic >

note right of RealtimeNotificationServiceImpl
  STOMP WebSocket endpoint routes realtime alerts to online web sessions.
  Topics are strictly tenant-isolated via /topic/tenant.{tenantId}.
end note

@enduml
