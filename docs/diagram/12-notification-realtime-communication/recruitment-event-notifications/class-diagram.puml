@startuml
title NOTIFY — Recruitment Event Notifications\nLayered target application-design viewpoint
top to bottom direction

skinparam dpi 300
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 12
skinparam linetype ortho
skinparam ArrowColor #334155
skinparam ArrowThickness 1
skinparam ClassBorderColor #64748B
skinparam ClassBorderThickness 1
skinparam ClassBackgroundColor #F8FAFC
skinparam InterfaceBackgroundColor #F3E8FF
skinparam PackageBorderColor #475569
skinparam PackageBorderThickness 1
skinparam DefaultFontColor #111827
skinparam ClassFontColor #111827
skinparam ClassAttributeFontColor #111827
skinparam NoteBackgroundColor #FFF7ED
skinparam NoteBorderColor #FDBA74

package "Routing & Boundary" #EFF6FF {
  class HiringDomainServices <<existing modules>> {
    +applyJob()
    +moveStage()
    +decideHireOrReject()
    +inviteAssessment()
    +inviteInterview()
  }
}

package "Service Layer" #F0FDF4 {
  class RecruitmentNotificationDispatcher <<Service, conceptual>> {
    -notificationRepository: NotificationRepository
    -emailProducer: EmailNotificationProducer
    -tenantContext: TenantContext
    +dispatch(event: RecruitmentNotificationEvent): void
    +canNotifyResult(applicationId: Long, recipientRole: String): boolean
  }
}

package "DTO Layer" #FFF7ED {
  class RecruitmentNotificationEvent <<Event, conceptual>> {
    +type: NotificationType
    +actorUserId: Long [0..1]
    +recipientUserId: Long
    +applicationId: Long
    +jobId: Long [0..1]
    +sourceEventId: String
  }
}

package "Repository Layer" #F5F3FF {
  interface NotificationRepository <<Repository>> {
    +save(notification: Notification): Notification
  }
}

package "Domain Entity Layer" #F0FDF4 {
  entity Notification <<Entity>> {
    -id: Long
    -userId: Long
    -type: String
    -title: String
    -payloadJson: String [0..1]
    -readAt: Instant [0..1]
  }
  enum NotificationType <<enumeration, conceptual>> {
    APPLICATION_SUBMITTED
    STAGE_CHANGED
    APPLICATION_REJECTED
    OFFER_CREATED
    ASSESSMENT_INVITED
    INTERVIEW_INVITED
    SCHEDULE_REMINDER
    RESULT_AVAILABLE
  }
}

package "Infrastructure & Persistence" #FEFCE8 {
  interface EmailNotificationProducer <<Messaging Port, conceptual>> {
    +publish(command: SendEmailCommand): void
  }
  class "RabbitMQ notify.email" as NotifyBroker <<Message Broker>> {
    +notify.email.q
  }
  class "Dedicated Tenant MySQL DB" as TenantDB <<Database>> {
    +notifications
  }
  class TenantContext <<ThreadLocal>> {
    +{static} getCurrentTenant(): String
    +{static} clear(): void
  }
}

HiringDomainServices -down-> RecruitmentNotificationDispatcher : emits
HiringDomainServices ..> RecruitmentNotificationEvent : creates
RecruitmentNotificationDispatcher ..> RecruitmentNotificationEvent : processes
RecruitmentNotificationDispatcher -down-> NotificationRepository : persists inbox
RecruitmentNotificationDispatcher --> EmailNotificationProducer : fans out email
RecruitmentNotificationDispatcher --> TenantContext : enforces tenant scope
NotificationRepository -down-> Notification : manages
Notification --> NotificationType : typed by
Notification --> TenantDB : persists to
EmailNotificationProducer --> NotifyBroker : publishes X-Tenant-ID

RecruitmentNotificationEvent -[hidden]down-> Notification
NotifyBroker -[hidden]right-> TenantDB
TenantDB -[hidden]right-> TenantContext

note right of RecruitmentNotificationDispatcher
  RESULT_AVAILABLE reaches the candidate only after scores
  are released. Deep link is built into payload_json
  (tenantCode, resourceType, resourceId, path) for this tenant.
  WebSocket push and SMTP retry are other functions.
end note

@enduml
