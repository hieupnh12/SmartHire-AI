@startuml
title NOTIFY — In-App Notification Center\nLayered target application-design viewpoint
top to bottom direction

skinparam dpi 300
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 12
skinparam linetype ortho
skinparam ArrowColor #334155
skinparam ArrowThickness 1
skinparam ClassBorderColor #64748B
skinparam ClassBorderThickness 1
skinparam ClassBackgroundColor #F8FAFC
skinparam InterfaceBackgroundColor #F3E8FF
skinparam PackageBorderColor #475569
skinparam PackageBorderThickness 1
skinparam DefaultFontColor #111827
skinparam ClassFontColor #111827
skinparam ClassAttributeFontColor #111827
skinparam NoteBackgroundColor #FFF7ED
skinparam NoteBorderColor #FDBA74

package "Routing & Boundary" #EFF6FF {
  class NotificationInboxRoute <<REST API, conceptual>> {
    +GET /api/v1/notifications
    +PATCH /api/v1/notifications/{id}
    +PATCH /api/v1/notifications/read-all
  }
}

package "Controller Layer" #EFF6FF {
  class NotificationController <<Controller>> {
    -notificationService: NotificationService
    +list(unreadOnly: boolean): ApiResponse<NotificationListResponse>
    +markRead(id: Long): ApiResponse<NotificationResponse>
    +markAllRead(): ApiResponse<MarkAllReadResponse>
  }
}

package "Service Layer" #F0FDF4 {
  class NotificationService <<Service>> {
    -notificationRepository: NotificationRepository
    -tenantContext: TenantContext
    +listMine(userId: Long, unreadOnly: boolean): NotificationListResponse
    +markRead(userId: Long, id: Long): NotificationResponse
    +markAllRead(userId: Long): int
  }
}

package "DTO Layer" #FFF7ED {
  class NotificationListResponse <<Response, conceptual>> {
    +items: List<NotificationResponse>
    +unreadCount: long
  }
  class NotificationResponse <<Response, conceptual>> {
    +id: Long
    +type: String
    +title: String
    +body: String [0..1]
    +deepLink: String [0..1]
    +readAt: Instant [0..1]
    +createdAt: Instant
  }
  class MarkAllReadResponse <<Response, conceptual>> {
    +updatedCount: int
  }
}

package "Repository Layer" #F5F3FF {
  interface NotificationRepository <<Repository>> {
    +findByUserIdOrderByCreatedAtDesc(userId: Long): List<Notification>
    +countByUserIdAndReadAtIsNull(userId: Long): long
    +findByIdAndUserId(id: Long, userId: Long): Optional<Notification>
    +markAllRead(userId: Long, readAt: Instant): int
  }
}

package "Domain Entity Layer" #F0FDF4 {
  entity User <<Entity>> {
    -id: Long
    -fullName: String
    -status: UserStatus
  }
  entity Notification <<Entity>> {
    -id: Long
    -type: String
    -title: String
    -body: String [0..1]
    -payloadJson: String [0..1]
    -readAt: Instant [0..1]
    -createdAt: Instant
  }
}

package "Infrastructure & Persistence" #FEFCE8 {
  class "Dedicated Tenant MySQL DB" as TenantDB <<Database>> {
    +users
    +notifications
  }
  class TenantContext <<ThreadLocal>> {
    +{static} getCurrentTenant(): String
    +{static} clear(): void
  }
}

NotificationInboxRoute -down-> NotificationController : defines routes
NotificationController -down-> NotificationService : delegates
NotificationController ..> NotificationListResponse : returns
NotificationController ..> NotificationResponse : returns
NotificationController ..> MarkAllReadResponse : returns
NotificationService ..> NotificationListResponse : creates
NotificationService ..> NotificationResponse : creates
NotificationService -down-> NotificationRepository : persists through
NotificationService --> TenantContext : enforces tenant scope
NotificationRepository -down-> Notification : manages
User "1" *-- "0..*" Notification : inbox of
User --> TenantDB : persists to
Notification --> TenantDB : persists to

NotificationListResponse -[hidden]right-> NotificationResponse
NotificationResponse -[hidden]right-> MarkAllReadResponse
User -[hidden]right-> Notification
TenantDB -[hidden]right-> TenantContext

note right of NotificationService
  Queries always filter by caller userId.
  Unread count is derived from read_at IS NULL.
  No dedicated NotificationService interface exists in code.
end note

note right of NotificationInboxRoute
  GET/PATCH are product contract; controller currently exposes /health.
  PATCH .../read-all is designed; FE currently marks one item.
end note

@enduml
