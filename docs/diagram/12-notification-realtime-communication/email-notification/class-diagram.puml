@startuml
title NOTIFY — Email Notification\nApplication-design viewpoint

skinparam dpi 300
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam ArrowColor #64748B
skinparam ClassBorderColor #CBD5E1
skinparam ClassBackgroundColor #F8FAFC
skinparam InterfaceBackgroundColor #EFF6FF
skinparam NoteBackgroundColor #FFF7ED
skinparam NoteBorderColor #FDBA74

package "Tenant Application Layer" #F0FDF4 {
  class EmailNotificationService <<conceptual service>> {
    +enqueue(command: SendEmailCommand): void
  }

  class SendEmailCommand <<conceptual command>> {
    +toUserId: Long
    +toEmail: String
    +type: String
    +locale: String
    +model: Map
    +idempotencyKey: String
  }

  class MailTemplateRenderer <<conceptual domain service>> {
    +render(type: String, locale: String, model: Map): RenderedMail
  }

  class RenderedMail <<conceptual value>> {
    +subject: String
    +body: String
  }

  class EmailWorker <<conceptual worker>> {
    +onNotifyEmail(payload: String, tenantId: String): void
  }
}

package "Tenant Persistence Layer (Dedicated MySQL DB)" #FEFCE8 {
  entity EmailOutbox <<entity>> {
    +id: Long
    +toEmail: String
    +subject: String
    +body: String
    +status: NotificationStatus
    +attempts: int
    +sentAt: Instant [0..1]
  }

  entity MailTemplate <<conceptual entity>> {
    +type: String
    +locale: String
    +subjectTemplate: String
    +bodyTemplate: String
  }

  entity NotificationPreference <<conceptual entity>> {
    +userId: Long
    +type: String
    +emailEnabled: boolean
  }

  enum NotificationStatus <<enumeration>> {
    PENDING
    SENT
    FAILED
  }

  interface EmailOutboxRepository <<repository>> {
    +save(row: EmailOutbox): EmailOutbox
  }
}

package "Asynchronous Integration" #FAF5FF {
  class "RabbitMQ notify-email" as NotifyQueue <<queue>>
  class "SMTP provider" as Smtp <<external>>
}

EmailNotificationService ..> SendEmailCommand : processes
EmailNotificationService --> MailTemplateRenderer : renders through
EmailNotificationService --> EmailOutboxRepository : persists through
EmailNotificationService ..> NotificationPreference : consults
MailTemplateRenderer ..> MailTemplate : reads
MailTemplateRenderer ..> RenderedMail : produces
EmailOutboxRepository ..> EmailOutbox : manages
EmailOutbox --> NotificationStatus : typed by
EmailNotificationService ..> NotifyQueue : publishes X-Tenant-ID
EmailWorker ..> NotifyQueue : consumes
EmailWorker ..> Smtp : sends
EmailWorker --> EmailOutboxRepository : marks SENT

note bottom of MailTemplate
  Locales follow product i18n: en, vi, ja.
  No mail_templates table exists in Flyway yet.
end note

note right of EmailNotificationService
  Happy path only: first SMTP attempt succeeds.
  Retry, DLQ, and duplicate suppression
  belong to notification-delivery-reliability.
  OTP mail is AUTH, not this function.
end note

@enduml
