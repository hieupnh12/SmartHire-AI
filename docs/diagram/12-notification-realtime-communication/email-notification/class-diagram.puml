@startuml
title NOTIFY — Email Notification\nLayered target application-design viewpoint
top to bottom direction

skinparam dpi 300
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 12
skinparam linetype ortho
skinparam ArrowColor #334155
skinparam ArrowThickness 1
skinparam ClassBorderColor #64748B
skinparam ClassBorderThickness 1
skinparam ClassBackgroundColor #F8FAFC
skinparam InterfaceBackgroundColor #F3E8FF
skinparam PackageBorderColor #475569
skinparam PackageBorderThickness 1
skinparam DefaultFontColor #111827
skinparam ClassFontColor #111827
skinparam ClassAttributeFontColor #111827
skinparam NoteBackgroundColor #FFF7ED
skinparam NoteBorderColor #FDBA74

package "Service Layer" #F0FDF4 {
  class EmailNotificationService <<Service, conceptual>> {
    -emailOutboxRepository: EmailOutboxRepository
    -tenantContext: TenantContext
    +enqueue(command: SendEmailCommand): void
  }
}

package "DTO Layer" #FFF7ED {
  class SendEmailCommand <<Request, conceptual>> {
    +toUserId: Long
    +toEmail: String
    +type: String
    +locale: String
    +model: Map
    +idempotencyKey: String
  }
  class RenderedMail <<Response, conceptual>> {
    +subject: String
    +body: String
  }
}

package "Repository Layer" #F5F3FF {
  interface EmailOutboxRepository <<Repository>> {
    +save(row: EmailOutbox): EmailOutbox
  }
}

package "Domain Entity Layer" #F0FDF4 {
  entity EmailOutbox <<Entity>> {
    -id: Long
    -toEmail: String
    -subject: String
    -body: String
    -status: NotificationStatus
    -attempts: int
    -sentAt: Instant [0..1]
  }
  entity MailTemplate <<Entity, conceptual>> {
    -type: String
    -locale: String
    -subjectTemplate: String
    -bodyTemplate: String
  }
  entity NotificationPreference <<Entity, conceptual>> {
    -userId: Long
    -type: String
    -emailEnabled: boolean
  }
  enum NotificationStatus <<enumeration>> {
    PENDING
    SENT
    FAILED
  }
}

package "Infrastructure & Persistence" #FEFCE8 {
  class EmailWorker <<Worker, conceptual>> {
    +onNotifyEmail(payload: String, tenantId: String): void
  }
  class "RabbitMQ notify.email" as NotifyBroker <<Message Broker>> {
    +notify.email.q
  }
  class "SMTP provider" as Smtp <<External>>
  class "Dedicated Tenant MySQL DB" as TenantDB <<Database>> {
    +email_outbox
  }
  class TenantContext <<ThreadLocal>> {
    +{static} getCurrentTenant(): String
    +{static} clear(): void
  }
}

EmailNotificationService ..> SendEmailCommand : processes
EmailNotificationService ..> RenderedMail : creates
EmailNotificationService ..> NotificationPreference : consults
EmailNotificationService ..> MailTemplate : renders from
EmailNotificationService -down-> EmailOutboxRepository : persists through
EmailNotificationService --> TenantContext : enforces tenant scope
EmailNotificationService --> NotifyBroker : publishes X-Tenant-ID
EmailOutboxRepository -down-> EmailOutbox : manages
EmailOutbox --> NotificationStatus : typed by
EmailOutbox --> TenantDB : persists to
MailTemplate --> TenantDB : persists to
NotificationPreference --> TenantDB : persists to
EmailWorker ..> NotifyBroker : consumes
EmailWorker --> Smtp : sends
EmailWorker --> EmailOutboxRepository : marks SENT
EmailWorker --> TenantContext : restores tenant from header

SendEmailCommand -[hidden]right-> RenderedMail
MailTemplate -[hidden]right-> NotificationPreference
NotifyBroker -[hidden]right-> Smtp
Smtp -[hidden]right-> TenantDB
TenantDB -[hidden]right-> TenantContext

note right of EmailNotificationService
  Happy path: first SMTP attempt succeeds.
  Renders en/vi/ja templates inside the service.
  Retry, DLQ, and duplicate suppression belong to
  notification-delivery-reliability. OTP is AUTH.
end note

@enduml
