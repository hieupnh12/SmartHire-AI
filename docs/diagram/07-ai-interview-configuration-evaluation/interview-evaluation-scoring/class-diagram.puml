@startuml
!include ../class-style.puml

package "Controller Layer" {
  class InterviewController <<Controller>> {
    - interviewService: InterviewService
    + requestScore(interviewId: Long): ApiResponse<ScoreAcceptedResponse>
  }
}

package "DTO Layer" {
  class ScoreAcceptedResponse <<Response>> {
    + interviewId: Long
    + status: InterviewStatus
    + accepted: boolean
  }
  class InterviewScoreJob <<Domain Event>> {
    + interviewId: Long
    + requestedBy: Long
    + correlationId: String
  }
  class QuestionEvaluation <<DTO>> {
    + questionId: Long
    + competency: String [0..1]
    + relevance: Decimal
    + depth: Decimal
    + softSkills: Decimal
    + questionScore: Decimal
  }
  class OverallScoreResult <<DTO>> {
    + overallScore: Decimal
    + breakdownJson: String
    + modelVersion: String
  }
}

package "Service Layer" {
  interface InterviewService <<Service>> {
    + requestScore(interviewId: Long, principal: Principal): ScoreAcceptedResponse
  }
  class InterviewServiceImpl <<Service>> {
    - interviewRepository: InterviewRepository
    - scorePublisher: InterviewScorePublisher
    - tenantContext: TenantContext
    + requestScore(interviewId: Long, principal: Principal): ScoreAcceptedResponse
  }
  interface InterviewScoringService <<Service>> {
    + scoreInterview(job: InterviewScoreJob): InterviewScore
  }
  class InterviewScoringServiceImpl <<Service>> {
    - interviewRepository: InterviewRepository
    - analysisRepository: InterviewAnswerAnalysisRepository
    - scoreRepository: InterviewScoreRepository
    - rubric: ScoringRubricPolicy
    - tenantContext: TenantContext
    + scoreInterview(job: InterviewScoreJob): InterviewScore
  }
  class ScoringRubricPolicy <<Service>> {
    + evaluate(answer: InterviewAnswer, question: InterviewQuestion): QuestionEvaluation
    + aggregate(evaluations: List<QuestionEvaluation>): OverallScoreResult
  }
  class InterviewScoreConsumer <<Service>> {
    - scoringService: InterviewScoringService
    + onScoreRequested(job: InterviewScoreJob, tenantId: String): void
  }
}

package "Repository Layer" {
  interface InterviewRepository <<Repository>> {
    + findById(id: Long): Optional<Interview>
    + save(interview: Interview): Interview
  }
  interface InterviewAnswerAnalysisRepository <<Repository>> {
    + upsertByAnswer(analysis: InterviewAnswerAnalysis): InterviewAnswerAnalysis
  }
  interface InterviewScoreRepository <<Repository>> {
    + upsertByInterview(score: InterviewScore): InterviewScore
  }
}

package "Domain Entity Layer" {
  class Interview <<Entity>> {
    - id: Long
    - status: InterviewStatus
  }
  class InterviewQuestion <<Entity>> {
    - id: Long
    - sortOrder: int
    - questionText: String
    - competency: String [0..1]
  }
  class InterviewAnswer <<Entity>> {
    - id: Long
    - transcript: String [0..1]
    - status: String
  }
  class InterviewAnswerAnalysis <<Entity>> {
    - id: Long
    - analysisJson: String
    - modelVersion: String
  }
  class InterviewScore <<Entity>> {
    - id: Long
    - overallScore: Decimal
    - breakdownJson: String
    - modelVersion: String
    - createdAt: Instant
  }
  enum InterviewStatus <<Enum>> {
    CREATED
    QUESTIONS_READY
    IN_PROGRESS
    SCORING
    SCORED
    FAILED
  }
}

package "Infrastructure & Persistence" {
  class InterviewScorePublisher <<Queue>> {
    + publish(job: InterviewScoreJob, tenantId: String): void
  }
  class TenantMySQL <<Database>> {
    .. Dedicated Tenant DB ..
    + interviews
    + interview_questions
    + interview_answers
    + interview_answer_analyses
    + interview_scores
  }
  class ScoreQueue <<Queue>> {
    .. RabbitMQ interview.score ..
  }
  class TenantContext <<DataSource>> {
    + {static} getCurrentTenant(): String
    + {static} setCurrentTenant(tenantId: String): void
    + {static} clear(): void
  }
}

InterviewController ..> ScoreAcceptedResponse : returns >
InterviewController --> InterviewService : delegates >
InterviewService <|.. InterviewServiceImpl : implements
InterviewServiceImpl ..> ScoreAcceptedResponse : creates >
InterviewServiceImpl ..> InterviewScoreJob : emits >
InterviewServiceImpl --> InterviewRepository : queries >
InterviewServiceImpl --> InterviewScorePublisher : publishes event >
InterviewServiceImpl --> TenantContext : caches / evicts >

InterviewScorePublisher --> ScoreQueue : publishes event >
ScoreQueue ..> InterviewScoreConsumer : delivers >
InterviewScoreConsumer --> InterviewScoringService : delegates >
InterviewScoreConsumer --> TenantContext : caches / evicts >
InterviewScoringService <|.. InterviewScoringServiceImpl : implements
InterviewScoringServiceImpl --> ScoringRubricPolicy : delegates >
InterviewScoringServiceImpl --> InterviewRepository : queries >
InterviewScoringServiceImpl --> InterviewAnswerAnalysisRepository : persists through >
InterviewScoringServiceImpl --> InterviewScoreRepository : persists through >
InterviewScoringServiceImpl ..> InterviewScoreJob : processes >
InterviewScoringServiceImpl ..> QuestionEvaluation : creates >
InterviewScoringServiceImpl ..> OverallScoreResult : creates >
ScoringRubricPolicy ..> QuestionEvaluation : creates >
ScoringRubricPolicy ..> OverallScoreResult : creates >

InterviewRepository --> Interview : manages >
InterviewAnswerAnalysisRepository --> InterviewAnswerAnalysis : manages >
InterviewScoreRepository --> InterviewScore : manages >
InterviewRepository --> TenantMySQL : persists to >
InterviewAnswerAnalysisRepository --> TenantMySQL : persists to >
InterviewScoreRepository --> TenantMySQL : persists to >

Interview "1" *-- "1..*" InterviewQuestion
InterviewQuestion "1" *-- "0..1" InterviewAnswer
InterviewAnswer "1" *-- "0..1" InterviewAnswerAnalysis
Interview "1" *-- "0..1" InterviewScore
Interview ..> InterviewStatus : typed by >

note right of ScoringRubricPolicy
  Fixed system rubric (choice 1):
  relevance, depth, soft-skills.
  questionScore combines criteria;
  competency comes from the question.
  AI output is advisory for human review.
end note

note right of InterviewScoringServiceImpl
  Idempotent re-score: upsert analysis
  and interview_scores; set status SCORED
  or FAILED. Ranking refresh is notified
  after success (INT-04), not owned here.
end note
@enduml
