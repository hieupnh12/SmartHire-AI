@startuml
title FE07-F01 — Interview Configuration & Session Management\nLayered target application-design viewpoint
top to bottom direction
skinparam dpi 300
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 12
skinparam linetype ortho
skinparam ArrowColor #334155
skinparam ArrowThickness 1
skinparam ClassBorderColor #64748B
skinparam ClassBorderThickness 1
skinparam ClassBackgroundColor #F8FAFC
skinparam InterfaceBackgroundColor #F3E8FF
skinparam PackageBorderColor #475569
skinparam PackageBorderThickness 1
skinparam DefaultFontColor #111827
skinparam ClassFontColor #111827
skinparam ClassAttributeFontColor #111827

package "Routing & Boundary" #EFF6FF {
  class InterviewSessionRoute <<REST API, conceptual>> {
    +POST /api/v1/interviews
  }
}

package "Controller Layer" #EFF6FF {
  class InterviewController <<Controller>> {
    -interviewService: InterviewService
    +createSession(request: CreateInterviewRequest): ApiResponse<InterviewResponse>
  }
}

package "Service Layer" #F0FDF4 {
  class InterviewService <<Service>> {
    -interviewRepository: InterviewRepository
    -jobRepository: JobRepository
    -userRepository: UserRepository
    -cvRepository: CvRepository
    -tenantContext: TenantContext
    +createSession(request: CreateInterviewRequest, principal: Principal): InterviewResponse
  }
}

package "DTO Layer" #FFF7ED {
  class CreateInterviewRequest <<Request>> {
    +jobId: Long
    +candidateId: Long
    +cvId: Long [0..1]
    +mode: InterviewMode
  }
  class InterviewResponse <<Response>> {
    +id: Long
    +jobId: Long
    +candidateId: Long
    +cvId: Long [0..1]
    +mode: InterviewMode
    +status: InterviewStatus
    +createdAt: Instant
  }
}

package "Repository Layer" #F5F3FF {
  interface InterviewRepository <<Repository>> {
    +save(interview: Interview): Interview
  }
  interface JobRepository <<Repository>> {
    +findById(id: Long): Optional<Job>
  }
  interface UserRepository <<Repository>> {
    +findById(id: Long): Optional<User>
  }
  interface CvRepository <<Repository>> {
    +findById(id: Long): Optional<Cv>
  }
}

package "Domain Entity Layer" #F0FDF4 {
  entity Interview <<Entity>> {
    -id: Long
    -job: Job
    -candidate: User
    -cv: Cv [0..1]
    -mode: InterviewMode
    -status: InterviewStatus
    -createdAt: Instant
  }
  entity Job <<Entity>> {
    -id: Long
    -title: String
    -status: JobStatus
  }
  entity User <<Entity>> {
    -id: Long
    -fullName: String
    -role: UserRole
    -status: UserStatus
  }
  entity Cv <<Entity>> {
    -id: Long
    -job: Job
    -user: User
    -status: CvStatus
  }
  enum InterviewMode <<Enumeration>> {
    AI_VOICE
    AI_TEXT
  }
  enum InterviewStatus <<Enumeration>> {
    CREATED
    QUESTIONS_READY
    IN_PROGRESS
    SCORING
    SCORED
    FAILED
  }
}

package "Infrastructure & Persistence" #FEFCE8 {
  class "Dedicated Tenant MySQL DB" as TenantDB <<Database>> {
    +interviews
    +jobs
    +users
    +cvs
  }
  class TenantContext <<ThreadLocal>> {
    +{static} getCurrentTenant(): String
    +{static} setCurrentTenant(tenantId: String): void
    +{static} clear(): void
  }
}

InterviewSessionRoute -down-> InterviewController : defines routes
InterviewController -down-> InterviewService : delegates
InterviewController ..> CreateInterviewRequest : consumes
InterviewController ..> InterviewResponse : returns
InterviewService ..> CreateInterviewRequest : processes
InterviewService ..> InterviewResponse : creates
InterviewService -down-> InterviewRepository : persists
InterviewService --> JobRepository : validates job
InterviewService --> UserRepository : validates candidate
InterviewService --> CvRepository : validates CV
InterviewService --> TenantContext : enforces tenant scope

InterviewRepository -down-> Interview : manages
JobRepository -down-> Job : manages
UserRepository -down-> User : manages
CvRepository -down-> Cv : manages

Interview "0..*" --> "1" Job : for position
Interview "0..*" --> "1" User : interviews
Interview "0..*" --> "0..1" Cv : references
Interview ..> InterviewMode : typed by
Interview ..> InterviewStatus : has status
Cv "0..*" --> "1" Job : belongs to job
Cv "0..*" --> "1" User : owned by

Interview --> TenantDB : persists to
Job --> TenantDB : persists to
User --> TenantDB : persists to
Cv --> TenantDB : persists to

CreateInterviewRequest -[hidden]right-> InterviewResponse
JobRepository -[hidden]right-> UserRepository
UserRepository -[hidden]right-> CvRepository
Job -[hidden]right-> User
User -[hidden]right-> Cv
InterviewMode -[hidden]right-> InterviewStatus
TenantDB -[hidden]right-> TenantContext

note right of InterviewService
  Creates an AI interview session in CREATED status only.
  Does not generate questions, start STT, or score.
  Candidate must be ACTIVE with role CANDIDATE.
  Optional CV must belong to the same candidate and job.
end note

note bottom of InterviewMode
  Target design: mode is required on create.
  Current Flyway interviews table does not yet store mode;
  treat as planned column for this function.
end note
@enduml
