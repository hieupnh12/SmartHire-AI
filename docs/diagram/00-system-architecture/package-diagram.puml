@startuml
title SmartHire-AI - Package Diagram (FrontEnd / BackEnd Layers)

skinparam dpi 300
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rect
skinparam defaultFontName Arial
skinparam ArrowColor #34475B

left to right direction

package "Users" as users #E5EAF0

package "FrontEnd\n(frontend/src)" as FE #F1FAF5 {
  package "Presentation layer" as FE_Pres #D9F3F6 {
    package "main.tsx" as feMain
    package "app" as feApp
    package "features/master" as feMaster #DDF2E8
    package "features/tenant" as feTenant #F0E3FA
    package "components" as feComp
    package "pages (in features)" as fePages #DFEBFF
    package "routes / guards" as feRoutes #DFEBFF
  }
  package "State layer" as FE_State #F0E3FA {
    package "hooks" as feHooks
    package "stores" as feStores
  }
  package "Shared utilities" as FE_Shared #E5EAF0 {
    package "lib" as feLib #FFE9CE
    package "styles" as feStyles
    package "i18n" as feI18n
    package "types" as feTypes
  }
  package "Api / Data access layer" as FE_Api #DFEBFF {
    package "api/master" as apiMaster #DDF2E8
    package "api/tenant" as apiTenant #F0E3FA
  }
}

package "BackEnd\n(com.smarthire)" as BE #F8FAFC {
  package "Controller layer" as BE_Ctrl #DFEBFF {
    package "config" as beConfig
    package "security" as beSec #E7F4D9
    package "multitenancy" as beMt #FFE9CE
    package "master.*.controller" as beMasterCtrl #DDF2E8
    package "tenant.*.controller" as beTenantCtrl #F0E3FA
  }
  package "Service layer" as BE_Svc #F0E3FA {
    package "master.*.service" as beMasterSvc #DDF2E8
    package "tenant.*.service" as beTenantSvc #F0E3FA
    package "messaging" as beMsg #FCE2E0
    package "common.exception" as beEx
    package "common.api" as beApi
  }
  package "Data Access layer" as BE_Dal #DAF2ED {
    package "domain.master" as domMaster #DDF2E8
    package "domain.tenant" as domTenant #F0E3FA
    package "domain.enums" as domEnums
    package "dto + mapper" as beDto #DFEBFF
    package "multitenancy.datasource" as beDs #FFE9CE
    package "common.redis" as beRedis #FCE2E0
  }
}

package "Stores" as STORES #E0EAFE {
  database "PostgreSQL\nMaster DB" as pg
  database "MySQL\nTenant DB" as my
  database "Redis" as redis
  queue "RabbitMQ" as rabbit
}

' =========================
' FrontEnd
' =========================

users ..> FE_Pres : <<Use>>

feMain ..> feApp : <<access>>
feApp ..> feComp : <<access>>
feRoutes ..> fePages : <<access>>

FE_Pres ..> FE_State : <<usage>>
FE_Pres ..> FE_Shared : <<usage>>
FE_Pres ..> FE_Api : <<dependency>>

apiMaster ..> feLib
apiTenant ..> feLib

apiMaster ..> beMasterCtrl : <<HTTPS / JSON>>
apiTenant ..> beTenantCtrl : <<HTTPS / JSON>>\nJWT + Tenant Context


' =========================
' Backend Layers
' =========================

beMasterCtrl ..> beMasterSvc : <<calls>>
beTenantCtrl ..> beTenantSvc : <<calls>>

BE_Ctrl ..> beDto : <<request / response>>

beConfig ..> beSec : <<configuration>>

beMasterSvc ..> beEx : <<uses>>
beTenantSvc ..> beEx : <<uses>>

beTenantSvc ..> beMsg : <<publishes events>>

beSec ..> beMt : <<tenant context>>
beMt ..> beDs : <<resolve datasource>>


' =========================
' Domain / DTO
' =========================

beMasterSvc ..> domMaster : <<uses>>
beTenantSvc ..> domTenant : <<uses>>

beDto ..> domMaster : <<mapping>>
beDto ..> domTenant : <<mapping>>


' =========================
' Databases
' =========================

BE_Dal ..> pg : <<Master DB>>
BE_Dal ..> beDs : <<Tenant DataSource>>

beRedis ..> redis
beMsg ..> rabbit

legend right
  |= Color |= Meaning |
  | green | Master / platform |
  | purple | Tenant / recruiting |
  | orange | Multi-tenant / async |
  Layout mirrors Users | FrontEnd layers | BackEnd layers | Stores.
  Selected dependencies only.
endlegend
@enduml
