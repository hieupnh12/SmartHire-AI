@startuml
title PIPE — Configure Recruitment Pipeline\nLayered target application-design viewpoint
top to bottom direction

skinparam dpi 300
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 12
skinparam linetype ortho
skinparam ArrowColor #334155
skinparam ArrowThickness 1
skinparam ClassBorderColor #64748B
skinparam ClassBorderThickness 1
skinparam ClassBackgroundColor #F8FAFC
skinparam InterfaceBackgroundColor #F3E8FF
skinparam PackageBorderColor #475569
skinparam PackageBorderThickness 1
skinparam DefaultFontColor #111827
skinparam ClassFontColor #111827
skinparam ClassAttributeFontColor #111827
skinparam NoteBackgroundColor #FFF7ED
skinparam NoteBorderColor #FDBA74

package "Routing & Boundary" #EFF6FF {
  class PipelineTemplateRoute <<REST API, conceptual>> {
    +GET /api/v1/tenant/pipeline-template
    +PUT /api/v1/tenant/pipeline-template
    +POST /api/v1/jobs/{jobId}/pipeline:apply-template
  }
}

package "Controller Layer" #EFF6FF {
  class PipelineTemplateController <<Controller, conceptual>> {
    -pipelineTemplateService: PipelineTemplateService
    +getTemplate(): ApiResponse<PipelineTemplateResponse>
    +saveTemplate(request: SaveTemplateRequest): ApiResponse<PipelineTemplateResponse>
    +applyToJob(jobId: Long): ApiResponse<JobPipelineResponse>
  }
}

package "Service Layer" #F0FDF4 {
  class PipelineTemplateService <<Service, conceptual>> {
    -templateRepository: PipelineTemplateRepository
    -jobRepository: JobRepository
    -stageRepository: RecruitmentStageRepository
    -tenantContext: TenantContext
    +getTemplate(): PipelineTemplateResponse
    +saveTemplate(request: SaveTemplateRequest): PipelineTemplateResponse
    +applyTemplateToJob(jobId: Long): JobPipelineResponse
  }
}

package "DTO Layer" #FFF7ED {
  class SaveTemplateRequest <<Request, conceptual>> {
    +stages: TemplateStageDraft[*]
  }
  class PipelineTemplateResponse <<Response, conceptual>> {
    +id: Long
    +stages: TemplateStageDraft[*]
  }
  class JobPipelineResponse <<Response, conceptual>> {
    +jobId: Long
    +stageCount: int
  }
}

package "Repository Layer" #F5F3FF {
  interface PipelineTemplateRepository <<Repository, conceptual>> {
    +findSingleton(): Optional<PipelineTemplate>
    +save(template: PipelineTemplate): PipelineTemplate
  }
  interface JobRepository <<Repository>> {
    +findById(id: Long): Optional<Job>
  }
  interface RecruitmentStageRepository <<Repository>> {
    +countByJobId(jobId: Long): long
    +saveAll(stages: List<RecruitmentStage>): void
  }
}

package "Domain Entity Layer" #F0FDF4 {
  entity PipelineTemplate <<Entity, conceptual>> {
    -id: Long
    -updatedAt: Instant
  }
  entity TemplateStage <<Entity, conceptual>> {
    -code: String
    -name: String
    -sortOrder: int
    -isSystem: boolean
  }
  entity Job <<Entity>> {
    -id: Long
    -title: String
    -status: JobStatus
  }
  entity RecruitmentStage <<Entity>> {
    -id: Long
    -name: String
    -sortOrder: int
    -terminal: boolean
  }
}

package "Infrastructure & Persistence" #FEFCE8 {
  class "Dedicated Tenant MySQL DB" as TenantDB <<Database>> {
    +jobs
    +recruitment_stages
  }
  class TenantContext <<ThreadLocal>> {
    +{static} getCurrentTenant(): String
    +{static} clear(): void
  }
}

PipelineTemplateRoute -down-> PipelineTemplateController : defines routes
PipelineTemplateController -down-> PipelineTemplateService : delegates
PipelineTemplateController ..> SaveTemplateRequest : consumes
PipelineTemplateController ..> PipelineTemplateResponse : returns
PipelineTemplateController ..> JobPipelineResponse : returns
PipelineTemplateService ..> SaveTemplateRequest : processes
PipelineTemplateService -down-> PipelineTemplateRepository : persists through
PipelineTemplateService --> JobRepository : persists through
PipelineTemplateService --> RecruitmentStageRepository : persists through
PipelineTemplateService --> TenantContext : enforces tenant scope
PipelineTemplateRepository -down-> PipelineTemplate : manages
JobRepository -down-> Job : manages
RecruitmentStageRepository -down-> RecruitmentStage : manages
PipelineTemplate "1" *-- "1..*" TemplateStage : contains
Job "1" *-- "0..*" RecruitmentStage : owns
TemplateStage ..> RecruitmentStage : cloned as
PipelineTemplate --> TenantDB : persists to
Job --> TenantDB : persists to
RecruitmentStage --> TenantDB : persists to

SaveTemplateRequest -[hidden]right-> PipelineTemplateResponse
Job -[hidden]right-> RecruitmentStage
TenantDB -[hidden]right-> TenantContext

note right of PipelineTemplate
  Designed singleton per Tenant DB.
  Apply-template copies into recruitment_stages
  only when the job has zero stages.
end note

@enduml
