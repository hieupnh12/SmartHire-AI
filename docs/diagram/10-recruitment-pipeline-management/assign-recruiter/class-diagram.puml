@startuml
title PIPE — Assign Recruiter to Application\nLayered target application-design viewpoint
top to bottom direction

skinparam dpi 300
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 12
skinparam linetype ortho
skinparam ArrowColor #334155
skinparam ArrowThickness 1
skinparam ClassBorderColor #64748B
skinparam ClassBorderThickness 1
skinparam ClassBackgroundColor #F8FAFC
skinparam InterfaceBackgroundColor #F3E8FF
skinparam PackageBorderColor #475569
skinparam PackageBorderThickness 1
skinparam DefaultFontColor #111827
skinparam ClassFontColor #111827
skinparam ClassAttributeFontColor #111827
skinparam NoteBackgroundColor #FFF7ED
skinparam NoteBorderColor #FDBA74

package "Routing & Boundary" #EFF6FF {
  class AssignRecruiterRoute <<REST API, conceptual>> {
    +PATCH /api/v1/applications/{id}/assignee
  }
}

package "Controller Layer" #EFF6FF {
  class ApplicationAssigneeController <<Controller, conceptual>> {
    -assigneeService: ApplicationAssigneeService
    +assign(id: Long, request: AssignRecruiterRequest): ApiResponse<ApplicationCardResponse>
  }
}

package "Service Layer" #F0FDF4 {
  class ApplicationAssigneeService <<Service, conceptual>> {
    -applicationRepository: ApplicationRepository
    -userRepository: UserRepository
    -tenantContext: TenantContext
    +assign(actorId: Long, applicationId: Long, recruiterId: Long, expectedUpdatedAt: Instant): ApplicationCardResponse
  }
}

package "DTO Layer" #FFF7ED {
  class AssignRecruiterRequest <<Request, conceptual>> {
    +recruiterId: Long [0..1]
    +expectedUpdatedAt: Instant
  }
  class ApplicationCardResponse <<Response, conceptual>> {
    +id: Long
    +candidateName: String
    +stageId: Long
    +assignedRecruiterId: Long [0..1]
    +updatedAt: Instant
  }
}

package "Repository Layer" #F5F3FF {
  interface ApplicationRepository <<Repository>> {
    +findById(id: Long): Optional<Application>
    +save(application: Application): Application
  }
  interface UserRepository <<Repository>> {
    +findById(id: Long): Optional<User>
  }
}

package "Domain Entity Layer" #F0FDF4 {
  entity Application <<Entity>> {
    -id: Long
    -jobId: Long
    -stageId: Long [0..1]
    -assignedRecruiterId: Long [0..1]
    -updatedAt: Instant
  }
  entity User <<Entity>> {
    -id: Long
    -fullName: String
    -role: UserRole
    -status: UserStatus
  }
  entity ApplicationStatusHistory <<Entity>> {
    -id: Long
    -note: String [0..1]
    -changedBy: Long [0..1]
  }
  enum UserRole <<enumeration>> {
    TENANT_ADMIN
    ADMIN
    HR
    RECRUITER
  }
  enum UserStatus <<enumeration>> {
    ACTIVE
    LOCKED
    DISABLED
  }
}

package "Infrastructure & Persistence" #FEFCE8 {
  class "Dedicated Tenant MySQL DB" as TenantDB <<Database>> {
    +applications
    +users
    +application_status_history
  }
  class TenantContext <<ThreadLocal>> {
    +{static} getCurrentTenant(): String
    +{static} clear(): void
  }
}

AssignRecruiterRoute -down-> ApplicationAssigneeController : defines routes
ApplicationAssigneeController -down-> ApplicationAssigneeService : delegates
ApplicationAssigneeController ..> AssignRecruiterRequest : consumes
ApplicationAssigneeController ..> ApplicationCardResponse : returns
ApplicationAssigneeService ..> AssignRecruiterRequest : processes
ApplicationAssigneeService ..> ApplicationCardResponse : creates
ApplicationAssigneeService -down-> ApplicationRepository : persists through
ApplicationAssigneeService --> UserRepository : persists through
ApplicationAssigneeService --> TenantContext : enforces tenant scope
ApplicationRepository -down-> Application : manages
UserRepository -down-> User : manages
Application "0..*" --> "0..1" User : assignedRecruiter
Application "1" *-- "0..*" ApplicationStatusHistory : audit trail
User --> UserRole : typed by
User --> UserStatus : typed by
Application --> TenantDB : persists to
User --> TenantDB : persists to

AssignRecruiterRequest -[hidden]right-> ApplicationCardResponse
Application -[hidden]right-> User
TenantDB -[hidden]right-> TenantContext

note right of ApplicationAssigneeService
  Assignee must be ACTIVE HR, RECRUITER, ADMIN, or TENANT_ADMIN.
  Null recruiterId unassigns the card.
  assignedRecruiterId is designed; job owner is out of scope.
end note

@enduml
