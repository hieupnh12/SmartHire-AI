@startuml
skinparam dpi 300
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName "Arial"
skinparam defaultFontSize 11
skinparam sequence {
    ArrowColor #2D3748
    ActorBorderColor #2D3748
    LifeLineBorderColor #2D3748
    ParticipantBorderColor #2D3748
    ParticipantBackgroundColor #FFFFFF
    BoxBorderColor #A0AEC0
}

hide footbox
autonumber

actor "HR Manager / Recruiter" as Manager
boundary "Kanban Board Settings UI" as UI
control "Spring Security" as Security
control "TenantWebInterceptor" as Interceptor
boundary "JobStageController" as Controller
control "JobStageService" as Service
database "Tenant DB (MySQL)" as TenantDB

note over Manager, Security
  Preconditions: tenant ACTIVE; caller is assigned Recruiter / HR / Admin;
  Job exists in Tenant DB.
end note

== Add Custom Stage ==

Manager -> UI: Enter new stage name & insert position
activate UI
UI -> Security: POST /api/v1/jobs/{jobId}/stages
activate Security
Security -> Interceptor: Forward request
activate Interceptor
deactivate Security
Interceptor -> Interceptor: setCurrentTenant(tenantId)
Interceptor -> Controller: Route request
activate Controller

Controller -> Service: addStage(jobId, request)
activate Service
Service -> TenantDB: findJobById(jobId)
activate TenantDB
TenantDB --> Service: Job or empty
deactivate TenantDB

alt Job missing
  Service --> Controller: JOB_NOT_FOUND
  deactivate Service
  Controller --> UI: 404 Not Found
  deactivate Controller
  UI --> Manager: Show job not found error
  Interceptor -> Interceptor: clear TenantContext
  deactivate Interceptor
else Job exists
  Service -> TenantDB: INSERT recruitment_stages
  activate TenantDB
  TenantDB --> Service: Stage created
  deactivate TenantDB

  Service --> Controller: StageResponse
  deactivate Service
  Controller --> UI: 201 Created
  deactivate Controller
  UI --> Manager: Show new stage added on Kanban board
  Interceptor -> Interceptor: clear TenantContext
  deactivate Interceptor
end

== Delete Stage ==

Manager -> UI: Click Delete Stage on Kanban column
UI -> Security: DELETE /api/v1/jobs/{jobId}/stages/{stageId}
activate Security
Security -> Interceptor: Forward request
activate Interceptor
deactivate Security
Interceptor -> Interceptor: setCurrentTenant(tenantId)
Interceptor -> Controller: Route request
activate Controller

Controller -> Service: deleteStage(jobId, stageId)
activate Service
Service -> TenantDB: countByCurrentStageId(stageId)
activate TenantDB
TenantDB --> Service: applicantCount
deactivate TenantDB

alt Stage contains active candidates
  Service --> Controller: STAGE_NOT_EMPTY
  deactivate Service
  Controller --> UI: 409 Conflict
  deactivate Controller
  UI --> Manager: Block stage deletion (candidates must be moved first)
  Interceptor -> Interceptor: clear TenantContext
  deactivate Interceptor
else Stage is empty
  Service -> TenantDB: DELETE FROM recruitment_stages WHERE id = stageId
  activate TenantDB
  TenantDB --> Service: Stage deleted
  deactivate TenantDB

  Service --> Controller: Void response
  deactivate Service
  Controller --> UI: 204 No Content
  deactivate Controller
  UI --> Manager: Remove stage column from Kanban board
  Interceptor -> Interceptor: clear TenantContext
  deactivate Interceptor
end

deactivate UI

@enduml
