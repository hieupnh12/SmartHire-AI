@startuml
title PIPE — Manage Recruitment Stages\nLayered target application-design viewpoint
top to bottom direction

skinparam dpi 300
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 12
skinparam linetype ortho
skinparam ArrowColor #334155
skinparam ArrowThickness 1
skinparam ClassBorderColor #64748B
skinparam ClassBorderThickness 1
skinparam ClassBackgroundColor #F8FAFC
skinparam InterfaceBackgroundColor #F3E8FF
skinparam PackageBorderColor #475569
skinparam PackageBorderThickness 1
skinparam DefaultFontColor #111827
skinparam ClassFontColor #111827
skinparam ClassAttributeFontColor #111827
skinparam NoteBackgroundColor #FFF7ED
skinparam NoteBorderColor #FDBA74

package "Routing & Boundary" #EFF6FF {
  class JobStageRoute <<REST API, conceptual>> {
    +GET /api/v1/jobs/{jobId}/stages
    +POST /api/v1/jobs/{jobId}/stages
    +PATCH /api/v1/jobs/{jobId}/stages/{stageId}
    +PUT /api/v1/jobs/{jobId}/stages/order
    +DELETE /api/v1/jobs/{jobId}/stages/{stageId}
  }
}

package "Controller Layer" #EFF6FF {
  class RecruitmentStageController <<Controller, conceptual>> {
    -recruitmentStageService: RecruitmentStageService
    +list(jobId: Long): ApiResponse<List<StageResponse>>
    +create(jobId: Long, request: CreateStageRequest): ApiResponse<StageResponse>
    +update(jobId: Long, stageId: Long, request: UpdateStageRequest): ApiResponse<StageResponse>
    +reorder(jobId: Long, request: ReorderStagesRequest): ApiResponse<List<StageResponse>>
    +delete(jobId: Long, stageId: Long): void
  }
}

package "Service Layer" #F0FDF4 {
  class RecruitmentStageService <<Service, conceptual>> {
    -stageRepository: RecruitmentStageRepository
    -applicationRepository: ApplicationRepository
    -tenantContext: TenantContext
    +list(jobId: Long): List<StageResponse>
    +createCustom(jobId: Long, name: String): StageResponse
    +removeOrArchive(jobId: Long, stageId: Long): void
  }
}

package "DTO Layer" #FFF7ED {
  class CreateStageRequest <<Request, conceptual>> {
    +name: String
  }
  class UpdateStageRequest <<Request, conceptual>> {
    +name: String
  }
  class StageResponse <<Response, conceptual>> {
    +id: Long
    +code: String [0..1]
    +name: String
    +sortOrder: int
    +system: boolean
    +archived: boolean
  }
}

package "Repository Layer" #F5F3FF {
  interface RecruitmentStageRepository <<Repository>> {
    +findByJobIdOrderBySortOrder(jobId: Long): List<RecruitmentStage>
    +save(stage: RecruitmentStage): RecruitmentStage
  }
  interface ApplicationRepository <<Repository>> {
    +countByStageId(stageId: Long): long
  }
}

package "Domain Entity Layer" #F0FDF4 {
  entity Job <<Entity>> {
    -id: Long
    -title: String
  }
  entity RecruitmentStage <<Entity>> {
    -id: Long
    -name: String
    -sortOrder: int
    -terminal: boolean
    -system: boolean
    -code: SystemStageCode [0..1]
    -archivedAt: Instant [0..1]
  }
  entity Application <<Entity>> {
    -id: Long
    -stageId: Long [0..1]
  }
  enum SystemStageCode <<enumeration>> {
    APPLIED
    SCREENING
    ASSESSMENT
    INTERVIEW
    OFFER
    HIRED
    REJECTED
  }
}

package "Infrastructure & Persistence" #FEFCE8 {
  class "Dedicated Tenant MySQL DB" as TenantDB <<Database>> {
    +jobs
    +recruitment_stages
    +applications
  }
  class TenantContext <<ThreadLocal>> {
    +{static} getCurrentTenant(): String
    +{static} clear(): void
  }
}

JobStageRoute -down-> RecruitmentStageController : defines routes
RecruitmentStageController -down-> RecruitmentStageService : delegates
RecruitmentStageController ..> CreateStageRequest : consumes
RecruitmentStageController ..> UpdateStageRequest : consumes
RecruitmentStageController ..> StageResponse : returns
RecruitmentStageService ..> StageResponse : creates
RecruitmentStageService -down-> RecruitmentStageRepository : persists through
RecruitmentStageService --> ApplicationRepository : counts occupants
RecruitmentStageService --> TenantContext : enforces tenant scope
RecruitmentStageRepository -down-> RecruitmentStage : manages
ApplicationRepository -down-> Application : manages
Job "1" *-- "1..*" RecruitmentStage : owns
RecruitmentStage --> SystemStageCode : typed by when system
Application "0..*" --> "0..1" RecruitmentStage : currently in
Job --> TenantDB : persists to
RecruitmentStage --> TenantDB : persists to
Application --> TenantDB : persists to

CreateStageRequest -[hidden]right-> StageResponse
Job -[hidden]right-> Application
TenantDB -[hidden]right-> TenantContext

note right of SystemStageCode
  System rows cannot be hard-deleted.
  Archive only when empty. Custom stages have code = null.
end note

@enduml
