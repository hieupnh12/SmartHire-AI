@startuml
top to bottom direction
skinparam dpi 300
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam roundcorner 6
skinparam linetype ortho
skinparam defaultFontName "Arial"
skinparam defaultFontSize 11
skinparam classFontSize 11
skinparam classAttributeFontSize 10
skinparam classAttributeIconSize 10
skinparam ArrowThickness 1
skinparam ClassBorderThickness 1
skinparam PackageBorderThickness 1
skinparam NoteBackgroundColor #FFF7ED
skinparam NoteBorderColor #FDBA74

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #2D3748
  ArrowColor #2D3748
}
<style>
classDiagram {
  class { Padding 5 }
}
</style>

package "Controller Layer" #F7FAFC {
  class RankingGovernanceController <<Controller>> {
    +updateWeights(jobId: Long, request: WeightConfigRequest): RankingConfigResponse
    +getFairnessReport(jobId: Long, version: String): FairnessReportResponse
  }
}
package "DTO Layer" #FFFFFF {
  class WeightConfigRequest <<Request>> {
    +componentWeights: Map<Component, Integer>
    +skillGroupWeights: Map<String, Integer>
    +recommendationThresholds: Map<Label, Decimal>
    +expectedRevision: Long
  }
  class FairnessReportResponse <<Response>> {
    +rankingVersion: String
    +sampleSize: Integer
    +metrics: List<FairnessMetric>
    +alerts: List<FairnessAlert>
    +status: ReviewStatus
  }
}

package "Service Layer" #FFFFFF {
  interface RankingConfigurationService <<Service>> {
    +updateVersionedConfig(jobId: Long, request): RankingConfig
  }
  class RankingConfigurationServiceImpl <<Service>> {
    +updateVersionedConfig(jobId: Long, request): RankingConfig
  }
  interface FairnessMonitoringService <<Service>> {
    +evaluate(jobId: Long, rankingVersion: String): FairnessReport
  }
  class FairnessMonitoringServiceImpl <<Service>> {
    +evaluate(jobId: Long, rankingVersion: String): FairnessReport
  }
  class FairnessPolicy <<Service>> {
    +evaluate(metrics, thresholds): List<FairnessAlert>
    +isProtectedAttributeExcluded(config): boolean
  }
  class RankingService <<Service>> {
    +recomputeAndPersist(jobId: Long, trigger): RankingBoard
  }
}

package "Repository Layer" #FFFFFF {
  interface RankingConfigRepository <<Repository>> {
    +findForUpdate(jobId: Long): RankingConfig
    +save(config: RankingConfig): RankingConfig
  }
  interface FairnessReportRepository <<Repository>> {
    +save(report: FairnessReport): FairnessReport
    +find(jobId: Long, rankingVersion: String): FairnessReport
  }
}
package "Domain Entity Layer" #FFFFFF {
  entity RankingConfig <<Entity>> {
    +jobId: Long
    +revision: Long
    +algorithmVersion: String
    +weightsJson: JSON
    +thresholdsJson: JSON
    +updatedBy: Long
    +updatedAt: Instant
  }
  entity FairnessReport <<Entity>> {
    +id: Long
    +jobId: Long
    +rankingVersion: String
    +populationDefinition: String
    +metricsJson: JSON
    +alertsJson: JSON
    +status: ReviewStatus
    +generatedAt: Instant
  }
  class FairnessMetric <<Value Object>> {
    +name: String
    +groupKey: String
    +value: Decimal
    +sampleSize: Integer
  }
  class FairnessAlert <<Value Object>> {
    +metric: String
    +severity: Severity
    +messageCode: String
  }
}

package "Infrastructure & Persistence" #F7FAFC {
  class "Dedicated Tenant MySQL DB" as TenantDB <<Database>>
}

RankingGovernanceController --> RankingConfigurationService : delegates >
RankingGovernanceController --> FairnessMonitoringService : delegates >
RankingGovernanceController ..> WeightConfigRequest : consumes >
RankingGovernanceController ..> FairnessReportResponse : returns >
RankingConfigurationServiceImpl ..up|> RankingConfigurationService : implements
FairnessMonitoringServiceImpl ..up|> FairnessMonitoringService : implements
RankingConfigurationServiceImpl --> RankingConfigRepository : persists through >
RankingConfigurationServiceImpl --> RankingService : delegates recompute >
FairnessMonitoringServiceImpl --> FairnessPolicy : applies policy >
FairnessMonitoringServiceImpl --> FairnessReportRepository : persists through >
RankingConfigRepository ..> RankingConfig : manages >
FairnessReportRepository ..> FairnessReport : manages >
RankingConfigRepository --> TenantDB : persists to >
FairnessReportRepository --> TenantDB : persists to >
FairnessReport *-- "1..*" FairnessMetric : contains
FairnessReport *-- "0..*" FairnessAlert : contains

note right of FairnessPolicy
  Protected attributes are excluded from scoring inputs.
  Monitoring uses authorized, aggregated cohorts only.
  Small samples are suppressed; alerts request review
  and never automatically modify ranks or decisions.
end note

note bottom of RankingConfig
  Component and skill-group weights each total 100.
  Optimistic revision prevents lost updates.
  Every accepted change creates a new ranking version.
end note
@enduml
