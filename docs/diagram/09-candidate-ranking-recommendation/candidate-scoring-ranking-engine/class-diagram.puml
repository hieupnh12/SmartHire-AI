@startuml
top to bottom direction
skinparam dpi 300
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam roundcorner 6
skinparam linetype ortho
skinparam defaultFontName "Arial"
skinparam defaultFontSize 11
skinparam classFontSize 11
skinparam classAttributeFontSize 10
skinparam classAttributeIconSize 10
skinparam ArrowThickness 1
skinparam ClassBorderThickness 1
skinparam PackageBorderThickness 1
skinparam NoteBackgroundColor #FFF7ED
skinparam NoteBorderColor #FDBA74
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #2D3748
  ArrowColor #2D3748
}
<style>
classDiagram {
  class { Padding 5 }
}
</style>

package "Controller Layer" #F7FAFC {
  class RankingController <<Controller>> {
    +getBoard(jobId: Long): RankingBoardResponse
    +recompute(jobId: Long): RankingBoardResponse
    +getOverallScore(applicationId: Long): RankingRowResponse
  }
}

package "DTO Layer" #FFFFFF {
  class RankingBoardResponse <<Response>> {
    +jobId: Long
    +rankingVersion: String
    +calculatedAt: Instant
    +rows: List<RankingRowResponse>
  }
  class RankingRowResponse <<Response>> {
    +applicationId: Long
    +overallScore: Decimal [0..1]
    +rank: Integer [0..1]
    +recommendation: RecommendationLabel [0..1]
    +reasonCodes: List<String>
    +breakdown: ScoreBreakdown
  }
  class RankingSourceChanged <<Domain Event>> {
    +tenantId: String
    +jobId: Long
    +applicationId: Long
    +sourceType: SourceType
    +sourceVersion: String
    +eventId: UUID
  }
}

package "Service Layer" #FFFFFF {
  interface RankingService <<Service>> {
    +getCurrentBoard(jobId: Long): RankingBoardResponse
    +recomputeAndPersist(jobId: Long, trigger: RecalculationTrigger): RankingBoardResponse
  }
  class RankingServiceImpl <<Service>> {
    +getCurrentBoard(jobId: Long): RankingBoardResponse
    +recomputeAndPersist(jobId: Long, trigger: RecalculationTrigger): RankingBoardResponse
  }
  class RankingCalculator <<Service>> {
    +calculate(config, sources): ScoreBreakdown
    +rank(rows): List<RankingRowResponse>
  }
  class RecommendationPolicy <<Service>> {
    +classify(score, completeness, evidence): RecommendationLabel
    +explain(result): List<String>
  }
}

package "Repository Layer" #FFFFFF {
  interface RankingDataRepository <<Repository>> {
    +loadJobData(jobId: Long): RankingInput
  }
  interface RankingSnapshotRepository <<Repository>> {
    +replaceJobSnapshots(jobId: Long, version: String, snapshots): void
    +findLatestByJob(jobId: Long): List<RankingSnapshot>
  }
}

package "Domain Entity Layer" #FFFFFF {
  entity RankingConfig <<Entity>> {
    +jobId: Long
    +componentWeights: JSON
    +skillGroupWeights: JSON
    +revision: Long
    +algorithmVersion: String
  }
  entity RankingSnapshot <<Entity>> {
    +id: Long
    +jobId: Long
    +applicationId: Long
    +overallScore: Decimal [0..1]
    +rankPosition: Integer [0..1]
    +recommendation: RecommendationLabel [0..1]
    +cohort: String
    +breakdownJson: JSON
    +rankingVersion: String
    +sourceFingerprint: String
    +calculatedAt: Instant
  }
  entity Application <<Entity>> {
    +id: Long
    +status: ApplicationStatus
  }
  enum RecommendationLabel <<Enum>> {
    STRONG_FIT
    REVIEW
    NOT_RECOMMENDED
  }
}

package "Infrastructure & Persistence" #F7FAFC {
  class RankingSourceChangedConsumer <<Queue Consumer>> {
    +onSourceChanged(event: RankingSourceChanged): void
  }
  class "ranking.source.changed" as SourceQueue <<Queue>>
  class "Dedicated Tenant MySQL DB" as TenantDB <<Database>>
}

RankingController --> RankingService : delegates >
RankingController ..> RankingBoardResponse : returns >
RankingBoardResponse *-- "1..*" RankingRowResponse : contains
RankingRowResponse --> RecommendationLabel : typed by >
RankingServiceImpl ..up|> RankingService : implements
RankingServiceImpl --> RankingCalculator : delegates calculation >
RankingServiceImpl --> RecommendationPolicy : applies policy >
RankingServiceImpl --> RankingDataRepository : queries >
RankingServiceImpl --> RankingSnapshotRepository : persists through >
RankingSourceChangedConsumer --> RankingService : delegates >
RankingSourceChangedConsumer ..> RankingSourceChanged : consumes >
SourceQueue ..> RankingSourceChangedConsumer : delivers >
RankingDataRepository ..> Application : manages >
RankingDataRepository ..> RankingConfig : manages >
RankingSnapshotRepository ..> RankingSnapshot : manages >
Application "1" -- "0..*" RankingSnapshot : versioned results
RankingSnapshot --> RecommendationLabel : typed by >
RankingDataRepository --> TenantDB : reads from >
RankingSnapshotRepository --> TenantDB : persists to >

note right of RankingCalculator
  Score = weighted CV/skills, experience,
  assessment and interview evidence.
  Missing enabled components produce a normalized
  partial score and a distinct comparable cohort.
  Equal scores use competition ranking (1, 1, 3);
  applicationId only stabilizes display order.
end note

note right of RecommendationPolicy
  Target policy thresholds are versioned with configuration.
  Labels are advisory and MUST NOT automatically reject
  or change an Application status.
end note

note bottom of RankingSourceChangedConsumer
  Consumer restores TenantContext from X-Tenant-ID,
  deduplicates eventId/sourceVersion, recalculates one Job,
  and clears TenantContext in finally.
end note

@enduml
