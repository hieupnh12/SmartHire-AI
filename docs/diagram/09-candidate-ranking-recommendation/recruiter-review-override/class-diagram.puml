@startuml
top to bottom direction
skinparam dpi 300
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam roundcorner 6
skinparam linetype ortho
skinparam defaultFontName "Arial"
skinparam defaultFontSize 11
skinparam classFontSize 11
skinparam classAttributeFontSize 10
skinparam classAttributeIconSize 10
skinparam ArrowThickness 1
skinparam ClassBorderThickness 1
skinparam PackageBorderThickness 1
skinparam NoteBackgroundColor #FFF7ED
skinparam NoteBorderColor #FDBA74

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #2D3748
  ArrowColor #2D3748
}
<style>
classDiagram {
  class { Padding 5 }
}
</style>

package "Controller Layer" #F7FAFC {
  class RankingReviewController <<Controller>> {
    +getCandidateDetail(applicationId: Long): CandidateRankingDetail
    +shortlist(applicationId: Long, request: ShortlistRequest): ReviewResult
    +overrideRecommendation(applicationId: Long, request: OverrideRequest): ReviewResult
  }
}
package "DTO Layer" #FFFFFF {
  class OverrideRequest <<Request>> {
    +expectedRankingVersion: String
    +label: RecommendationLabel
    +reason: String
  }
  class ShortlistRequest <<Request>> {
    +expectedApplicationVersion: Long
    +note: String [0..1]
  }
  class CandidateRankingDetail <<Response>> {
    +rankingVersion: String
    +automatedLabel: RecommendationLabel
    +effectiveLabel: RecommendationLabel
    +breakdown: ScoreBreakdown
    +evidence: List<EvidenceSummary>
  }
}

package "Service Layer" #FFFFFF {
  interface RankingReviewService <<Service>> {
    +review(applicationId: Long): CandidateRankingDetail
    +override(actorId: Long, applicationId: Long, request): ReviewResult
    +shortlist(actorId: Long, applicationId: Long, request): ReviewResult
  }
  class RankingReviewServiceImpl <<Service>> {
    +review(applicationId: Long): CandidateRankingDetail
    +override(actorId: Long, applicationId: Long, request): ReviewResult
    +shortlist(actorId: Long, applicationId: Long, request): ReviewResult
  }
  class HumanDecisionPolicy <<Service>> {
    +canOverride(role, status, reason): boolean
    +requireHumanReview(action, automatedLabel): void
  }
  class AuditService <<Service>> {
    +record(event: AuditEvent): void
  }
}

package "Repository Layer" #FFFFFF {
  interface RankingReviewRepository <<Repository>> {
    +findDetail(applicationId: Long): CandidateRankingDetail
    +saveOverride(override: RankingOverride): RankingOverride
  }
  interface ApplicationRepository <<Repository>> {
    +findForUpdate(applicationId: Long): Application
    +save(application: Application): Application
  }
}
package "Domain Entity Layer" #FFFFFF {
  entity RankingOverride <<Entity>> {
    +id: Long
    +applicationId: Long
    +rankingVersion: String
    +originalLabel: RecommendationLabel
    +overrideLabel: RecommendationLabel
    +reason: String
    +overriddenBy: Long
    +createdAt: Instant
    +revokedAt: Instant [0..1]
  }
  entity Application <<Entity>> {
    +id: Long
    +status: ApplicationStatus
    +version: Long
    +humanReviewedAt: Instant [0..1]
  }
  entity AuditEvent <<Entity>> {
    +id: Long
    +actorId: Long
    +action: String
    +subjectId: Long
    +beforeJson: JSON
    +afterJson: JSON
    +reason: String
    +createdAt: Instant
  }
}

package "Infrastructure & Persistence" #F7FAFC {
  class "Dedicated Tenant MySQL DB" as TenantDB <<Database>>
}

RankingReviewController --> RankingReviewService : delegates >
RankingReviewController ..> OverrideRequest : consumes >
RankingReviewController ..> ShortlistRequest : consumes >
RankingReviewController ..> CandidateRankingDetail : returns >
RankingReviewServiceImpl ..up|> RankingReviewService : implements
RankingReviewServiceImpl --> HumanDecisionPolicy : applies policy >
RankingReviewServiceImpl --> RankingReviewRepository : persists through >
RankingReviewServiceImpl --> ApplicationRepository : persists through >
RankingReviewServiceImpl --> AuditService : delegates audit >
AuditService --> AuditEvent : creates >
RankingReviewRepository ..> RankingOverride : manages >
ApplicationRepository ..> Application : manages >
RankingReviewRepository --> TenantDB : persists to >
ApplicationRepository --> TenantDB : persists to >
Application "1" -- "0..*" RankingOverride : reviewed overrides
RankingOverride "1" --> "1" AuditEvent : evidenced by

note right of HumanDecisionPolicy
  AI output is advisory. REJECTED is forbidden
  without an authenticated human decision.
  Override requires a non-blank reason and never
  rewrites the original automated snapshot.
end note
@enduml
