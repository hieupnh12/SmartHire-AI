@startuml
title PIPE — Manage Recruitment Stages\nApplication-design viewpoint

skinparam dpi 300
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam ArrowColor #64748B
skinparam ClassBorderColor #CBD5E1
skinparam ClassBackgroundColor #F8FAFC
skinparam InterfaceBackgroundColor #EFF6FF
skinparam NoteBackgroundColor #FFF7ED
skinparam NoteBorderColor #FDBA74

package "Tenant Web / API Layer" #EFF6FF {
  class JobStageRoute <<REST API>> {
    +GET /api/v1/jobs/{jobId}/stages
    +POST /api/v1/jobs/{jobId}/stages
    +PATCH /api/v1/jobs/{jobId}/stages/{stageId}
    +PUT /api/v1/jobs/{jobId}/stages/order
    +DELETE /api/v1/jobs/{jobId}/stages/{stageId}
  }

  class RecruitmentStageController <<conceptual controller>> {
    +list(jobId: Long): List<StageResponse>
    +create(jobId: Long, request: CreateStageRequest): StageResponse
    +update(jobId: Long, stageId: Long, request: UpdateStageRequest): StageResponse
    +reorder(jobId: Long, request: ReorderStagesRequest): List<StageResponse>
    +delete(jobId: Long, stageId: Long): void
  }

  class CreateStageRequest <<conceptual request DTO>> {
    +name: String
  }

  class UpdateStageRequest <<conceptual request DTO>> {
    +name: String
  }

  class StageResponse <<conceptual response DTO>> {
    +id: Long
    +code: String [0..1]
    +name: String
    +sortOrder: int
    +system: boolean
    +archived: boolean
  }
}

package "Tenant Application Layer" #F0FDF4 {
  class RecruitmentStageService <<conceptual service>> {
    +list(jobId: Long): List<StageResponse>
    +createCustom(jobId: Long, name: String): StageResponse
    +rename(jobId: Long, stageId: Long, name: String): StageResponse
    +reorder(jobId: Long, orderedIds: Long[*]): List<StageResponse>
    +removeOrArchive(jobId: Long, stageId: Long): void
  }
}

package "Tenant Persistence Layer (Dedicated MySQL DB)" #FEFCE8 {
  enum SystemStageCode <<enumeration>> {
    APPLIED
    SCREENING
    ASSESSMENT
    INTERVIEW
    OFFER
    HIRED
    REJECTED
  }

  entity Job <<entity>> {
    +id: Long
    +title: String
  }

  entity RecruitmentStage <<entity>> {
    +id: Long
    +name: String
    +sortOrder: int
    +terminal: boolean
    +system: boolean
    +code: SystemStageCode [0..1]
    +archivedAt: Instant [0..1]
  }

  entity Application <<entity>> {
    +id: Long
    +stageId: Long [0..1]
  }

  interface RecruitmentStageRepository <<repository>> {
    +findByJobIdOrderBySortOrder(jobId: Long): List<RecruitmentStage>
    +save(stage: RecruitmentStage): RecruitmentStage
  }

  interface ApplicationRepository <<repository>> {
    +countByStageId(stageId: Long): long
  }
}

JobStageRoute ..> RecruitmentStageController : routes
RecruitmentStageController ..> CreateStageRequest : consumes
RecruitmentStageController ..> UpdateStageRequest : consumes
RecruitmentStageController ..> StageResponse : produces
RecruitmentStageController --> RecruitmentStageService : delegates to

RecruitmentStageService --> RecruitmentStageRepository : persists through
RecruitmentStageService --> ApplicationRepository : counts occupants
RecruitmentStageService ..> SystemStageCode : enforces catalog

Job "1" *-- "1..*" RecruitmentStage : owns
RecruitmentStage --> SystemStageCode : typed by when system
Application "0..*" --> "0..1" RecruitmentStage : currently in

RecruitmentStageRepository ..> RecruitmentStage : manages
ApplicationRepository ..> Application : manages

note bottom of SystemStageCode
  System catalog for this function: Applied, Screening,
  Assessment, Interview, Offer, Hired, Rejected.
  System rows cannot be hard-deleted; they may be archived
  only when empty. Custom stages have code = null.
end note

note bottom of RecruitmentStage
  Existing columns: name, sort_order, is_terminal.
  system, code, archivedAt are designed extensions.
end note

@enduml
