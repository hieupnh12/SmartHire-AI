@startuml
title TENANT-16 — Workspace Admin Suspend or Reactivate Tenant\nApplication-design viewpoint
skinparam dpi 300
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam ArrowColor #64748B
skinparam ClassBorderColor #CBD5E1
skinparam ClassBackgroundColor #F8FAFC
skinparam InterfaceBackgroundColor #EFF6FF
skinparam NoteBackgroundColor #FFF7ED
skinparam NoteBorderColor #FDBA74
package "Master API" #EFF6FF {
 class TenantStatusRoute <<REST API>> {
  +PATCH /api/v1/master/tenants/:id/status
 }
 class MasterTenantController <<Controller>> {
  +updateTenantStatus(id: Long, status: String): TenantResponse
 }
 class TenantResponse <<Response>> {
  +id: Long
  +code: String
  +name: String
  +subdomain: String
  +dbName: String
  +status: String
 }
}
package "Master Domain" #F0FDF4 {
 class MasterTenantService <<Service>> {
  +updateTenantStatus(id: Long, status: String): TenantInfo
  +getTenantById(id: Long): TenantInfo
 }
 interface TenantInfoRepository <<Repository>> {
  +changeOperationalStatus(id: Long, status: String): int
  +findById(id: Long): Optional<TenantInfo>
 }
 class TenantInfo <<Entity>> {
  +id: Long
  +code: String
  +status: String
  +updatedAt: LocalDateTime
 }
 enum TenantOperationalStatus {
  ACTIVE
  SUSPENDED
 }
 class "Master PostgreSQL\ntenants" as MasterDB <<Database>>
}
package "Tenant Connection Management" #FFF7ED {
 class DynamicMultiTenantConnectionProvider <<Infrastructure>> {
  -pools: Map<String, HikariDataSource>
  +evict(code: String): void
  +getConnection(identifier: String): Connection
 }
 class HikariDataSource <<Connection Pool>> {
  +close(): void
 }
}
TenantStatusRoute ..> MasterTenantController : routes
MasterTenantController --> MasterTenantService : uses
MasterTenantController ..> TenantResponse : returns
MasterTenantService --> TenantInfoRepository : conditionally updates
MasterTenantService --> DynamicMultiTenantConnectionProvider : evicts pool through
TenantInfoRepository --> TenantInfo : manages
TenantInfoRepository --> MasterDB : persists in
TenantInfo ..> TenantOperationalStatus : constrained by
DynamicMultiTenantConnectionProvider o-- "0..*" HikariDataSource : caches
note bottom of TenantInfoRepository
  The update succeeds only when the current state is ACTIVE or SUSPENDED.
  This prevents racing with provisioning and invalid activation from FAILED.
end note
note bottom of DynamicMultiTenantConnectionProvider
  Eviction closes the local process pool. Every later connection acquisition
  rechecks ACTIVE status against the master registry.
end note
@enduml
