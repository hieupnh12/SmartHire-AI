@startuml
!include ../class-style.puml
package "Controller Layer" #EEF6FF {
  class MasterTenantController <<Controller>> {
    - masterTenantService: MasterTenantService
    + updateTenantStatus(id: Long, status: TenantOperationalStatus): ApiResponse<TenantResponse>
  }
}
package "DTO Layer" #FFF8EF {
  class TenantResponse <<Response>> {
    + id: Long
    + code: String
    + name: String
    + status: TenantOperationalStatus
    + updatedAt: LocalDateTime
  }
}
package "Service Layer" #EFFBF4 {
  interface MasterTenantService <<Service>> {
    + updateTenantStatus(id: Long, status: TenantOperationalStatus): TenantResponse
  }
  class MasterTenantServiceImpl <<Service>> {
    - tenantRepository: TenantInfoRepository
    - connectionProvider: DynamicMultiTenantConnectionProvider
    + updateTenantStatus(id: Long, status: TenantOperationalStatus): TenantResponse
  }
}
package "Repository Layer" #F5F3FF {
  interface TenantInfoRepository <<Repository>> {
    + changeOperationalStatus(id: Long, status: TenantOperationalStatus): int
    + findById(id: Long): Optional<TenantInfo>
  }
}
package "Domain Entity Layer" #F0FBF5 {
  class TenantInfo <<Entity>> {
    - id: Long
    - code: String
    - status: TenantStatus
    - updatedAt: LocalDateTime
  }
  enum TenantOperationalStatus <<Enum>> {
    ACTIVE
    SUSPENDED
  }
  enum TenantStatus <<Enum>> {
    PROVISIONING
    ACTIVE
    SUSPENDED
    FAILED
  }
}
package "Infrastructure & Persistence" #FFFCEE {
  class DynamicMultiTenantConnectionProvider <<Infrastructure>> {
    - pools: Map<String, HikariDataSource>
    + evict(code: String): void
  }
  class HikariDataSource <<Connection Pool>> {
    + close(): void
  }
  class MasterPostgreSQL <<Database>> {
    + tenants
  }
}
MasterTenantController --> MasterTenantService : delegates >
MasterTenantController ..> TenantResponse : returns >
MasterTenantServiceImpl ..|> MasterTenantService : implements
MasterTenantService -[hidden]down-> MasterTenantServiceImpl
MasterTenantServiceImpl --> TenantInfoRepository : conditionally updates >
MasterTenantServiceImpl --> DynamicMultiTenantConnectionProvider : evicts pool >
MasterTenantServiceImpl ..> TenantResponse : creates >
TenantInfoRepository --> TenantInfo : manages >
TenantInfoRepository --> MasterPostgreSQL : persists to >
TenantInfo --> TenantStatus : typed by >
TenantOperationalStatus ..> TenantStatus : restricts target state >
DynamicMultiTenantConnectionProvider o-- "0..*" HikariDataSource : caches >
note bottom of TenantInfoRepository
  Atomic update accepts only current ACTIVE or SUSPENDED state;
  PROVISIONING and FAILED cannot bypass provisioning.
end note
@enduml

