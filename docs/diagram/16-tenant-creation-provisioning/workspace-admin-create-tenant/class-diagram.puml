@startuml
!include ../class-style.puml

package "Controller Layer" #EEF6FF {
  class MasterTenantController <<Controller>> {
    - masterTenantService: MasterTenantService
    + onboardTenant(request: OnboardTenantRequest): ApiResponse<TenantResponse>
  }
}
package "DTO Layer" #FFF8EF {
  class OnboardTenantRequest <<Request>> {
    + code: String
    + name: String
    + subdomain: String
    + adminName: String
    + adminEmail: String
    + adminPassword: String {writeOnly}
    + customDbUrl: String [0..1]
  }
  class TenantResponse <<Response>> {
    + id: Long
    + code: String
    + name: String
    + subdomain: String
    + dbName: String
    + status: TenantStatus
  }
}
package "Service Layer" #EFFBF4 {
  interface MasterTenantService <<Service>> {
    + onboardTenant(request: OnboardTenantRequest): TenantResponse
  }
  class MasterTenantServiceImpl <<Service>> {
    - tenantRepository: TenantInfoRepository
    - provisioningService: TenantProvisioningService
    + onboardTenant(request: OnboardTenantRequest): TenantResponse
  }
  interface TenantProvisioningService <<Service>> {
    + provision(tenant: TenantInfo, request: OnboardTenantRequest): void
  }
  class TenantProvisioningServiceImpl <<Service>> {
    - dataSourceFactory: TenantDataSourceFactory
    - flywayService: FlywayMigrationService
    + provision(tenant: TenantInfo, request: OnboardTenantRequest): void
  }
}
package "Repository Layer" #F5F3FF {
  interface TenantInfoRepository <<Repository>> {
    + existsByCode(code: String): boolean
    + existsBySubdomain(subdomain: String): boolean
    + save(tenant: TenantInfo): TenantInfo
  }
}
package "Domain Entity Layer" #F0FBF5 {
  class TenantInfo <<Entity>> {
    - id: Long
    - code: String
    - name: String
    - subdomain: String
    - dbName: String
    - encryptedDbPassword: String
    - managedDatabase: boolean
    - status: TenantStatus
    + activate(): void
    + failProvisioning(): void
  }
  class TenantAdminUser <<Entity>> {
    - id: Long
    - email: String
    - passwordHash: String
    - role: UserRole
  }
  enum TenantStatus <<Enum>> {
    PROVISIONING
    ACTIVE
    SUSPENDED
    FAILED
  }
}
package "Infrastructure & Persistence" #FFFCEE {
  class TenantDataSourceFactory <<Infrastructure>> {
    + createDatabaseAndUser(tenant: TenantInfo): DataSource
  }
  class FlywayMigrationService <<Infrastructure>> {
    + migrateTenant(dataSource: DataSource): void
  }
  class MasterPostgreSQL <<Database>> {
    + tenants
  }
  class DedicatedTenantMySQL <<Database>> {
    + users
    + flyway_schema_history
  }
}
MasterTenantController --> MasterTenantService : delegates >
MasterTenantController ..> OnboardTenantRequest : consumes >
MasterTenantController ..> TenantResponse : returns >
MasterTenantServiceImpl ..|> MasterTenantService : implements
MasterTenantService -[hidden]down-> MasterTenantServiceImpl
MasterTenantServiceImpl --> TenantInfoRepository : persists metadata >
MasterTenantServiceImpl --> TenantProvisioningService : delegates provisioning >
TenantProvisioningServiceImpl ..|> TenantProvisioningService : implements
TenantProvisioningService -[hidden]down-> TenantProvisioningServiceImpl
TenantProvisioningServiceImpl --> TenantDataSourceFactory : creates tenant database >
TenantProvisioningServiceImpl --> FlywayMigrationService : runs migration >
TenantProvisioningServiceImpl ..> TenantAdminUser : seeds admin >
TenantInfoRepository --> TenantInfo : manages >
TenantInfoRepository --> MasterPostgreSQL : persists to >
TenantInfo --> TenantStatus : typed by >
TenantDataSourceFactory --> DedicatedTenantMySQL : provisions >
FlywayMigrationService --> DedicatedTenantMySQL : migrates >
DedicatedTenantMySQL *-- TenantAdminUser : stores >
@enduml

