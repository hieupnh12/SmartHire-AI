@startuml
title TENANT-16 — Workspace Admin View Tenant Directory and Details\nApplication-design viewpoint
skinparam dpi 300
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam ArrowColor #64748B
skinparam ClassBorderColor #CBD5E1
skinparam ClassBackgroundColor #F8FAFC
skinparam InterfaceBackgroundColor #EFF6FF
skinparam NoteBackgroundColor #FFF7ED
skinparam NoteBorderColor #FDBA74
package "Master UI and API" #EFF6FF {
 class MasterAdminDashboard <<Boundary>> {
  +loadTenantDirectory(): void
  +showTenantDetails(id: Long): void
 }
 class TenantDirectoryRoute <<REST API>> {
  +GET /api/v1/master/tenants
  +GET /api/v1/master/tenants/:id
 }
 class MasterTenantController <<Controller>> {
  +getAllTenants(): List<TenantResponse>
  +getTenantById(id: Long): TenantResponse
 }
 class TenantResponse <<Response>> {
  +id: Long
  +code: String
  +name: String
  +subdomain: String
  +dbName: String
  +status: String
  +createdAt: LocalDateTime
 }
}
package "Master Domain" #F0FDF4 {
 class MasterTenantService <<Service>> {
  +getAllTenants(): List<TenantInfo>
  +getTenantById(id: Long): TenantInfo
 }
 interface TenantInfoRepository <<Repository>> {
  +findAll(): List<TenantInfo>
  +findById(id: Long): Optional<TenantInfo>
 }
 class TenantInfo <<Entity>> {
  +id: Long
  +code: String
  +name: String
  +subdomain: String
  +dbName: String
  +status: String
  +createdAt: LocalDateTime
 }
 class "Master PostgreSQL\ntenants" as MasterDB <<Database>>
}
MasterAdminDashboard ..> TenantDirectoryRoute : calls
TenantDirectoryRoute ..> MasterTenantController : routes
MasterTenantController --> MasterTenantService : uses
MasterTenantController ..> "0..*" TenantResponse : maps and returns
MasterTenantService --> TenantInfoRepository : reads through
TenantInfoRepository --> "0..*" TenantInfo : manages
TenantInfoRepository --> MasterDB : reads from
TenantResponse ..> TenantInfo : maps from
note bottom of TenantResponse
  Safe projection only. It deliberately omits dbUrl,
  dbUsername, encrypted dbPassword, and managed credentials.
end note
note bottom of MasterAdminDashboard
  Search and status filtering currently occur client-side
  after the complete tenant list is loaded.
end note
@enduml
