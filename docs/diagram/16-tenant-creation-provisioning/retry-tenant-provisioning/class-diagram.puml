@startuml
skinparam dpi 300
skinparam shadowing false
skinparam packageStyle rectangle
skinparam roundcorner 6
skinparam linetype ortho
skinparam defaultFontName "Arial"
skinparam defaultFontSize 11
skinparam classFontSize 11
skinparam classAttributeFontSize 10

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #2D3748
    ArrowColor #2D3748
}

package "Routing & Boundary" {
    class TenantRetryRoute <<REST API>> {
        + POST /api/v1/master/tenants/{id}/retry
    }
}

package "Controller Layer" {
    class MasterTenantController <<Controller>> {
        - masterTenantService: MasterTenantService
        + retry(id: Long, request: TenantAdminRequest): ApiResponse<TenantResponse>
    }
}

package "DTO Layer" {
    class TenantAdminRequest <<Request>> {
        + adminName: String
        + adminEmail: String
        + adminPassword: String
    }

    class TenantResponse <<Response>> {
        + id: Long
        + code: String
        + name: String
        + subdomain: String
        + dbName: String
        + status: String
    }

    class TenantRetryCompletedEvent <<Domain Event>> {
        + tenantId: Long
        + code: String
        + status: String
        + timestamp: LocalDateTime
    }
}

package "Service Layer" {
    interface MasterTenantService <<Service>> {
        + retryProvisioning(id: Long, request: TenantAdminRequest): TenantResponse
    }

    class MasterTenantServiceImpl <<Service>> {
        - tenantInfoRepository: TenantInfoRepository
        - tenantProvisioningService: TenantProvisioningService
        - rabbitTemplate: RabbitTemplate
        + retryProvisioning(id: Long, request: TenantAdminRequest): TenantResponse
    }

    interface TenantProvisioningService <<Service>> {
        + retryProvision(tenant: TenantInfo, request: TenantAdminRequest): void
    }

    class TenantProvisioningServiceImpl <<Service>> {
        - tenantDataSourceFactory: TenantDataSourceFactory
        - tenantAdvisoryLockManager: TenantAdvisoryLockManager
        + retryProvision(tenant: TenantInfo, request: TenantAdminRequest): void
        - ensureDatabaseAndUser(tenant: TenantInfo): void
        - runFlywayMigration(dataSource: DataSource): void
        - seedOrUpdateAdmin(dataSource: DataSource, request: TenantAdminRequest): void
    }
}

package "Repository Layer" {
    interface TenantInfoRepository <<Repository>> {
        + findById(id: Long): Optional<TenantInfo>
        + saveAndFlush(tenant: TenantInfo): TenantInfo
    }
}

package "Domain Entity Layer" {
    enum TenantStatus <<Enum>> {
        PROVISIONING
        ACTIVE
        SUSPENDED
        FAILED
    }

    class TenantInfo <<Entity>> {
        - id: Long
        - code: String
        - name: String
        - subdomain: String
        - dbName: String
        - dbUrl: String
        - dbUsername: String
        - dbPassword: String
        - managedDatabase: boolean
        - status: TenantStatus
    }

    class TenantUser <<Entity>> {
        - id: Long
        - email: String
        - fullName: String
        - passwordHash: String
        - role: String
        - status: String
    }
}

package "Infrastructure & Persistence" {
    class MasterPostgreSQL <<Database>> {
        .. Master Landlord DB ..
        + tenants
        + pg_try_advisory_lock()
    }

    class DedicatedTenantMySQL <<Database>> {
        .. Isolated Tenant DB ..
        + users
        + user_profiles
    }

    class RabbitMQExchange <<Queue>> {
        .. Lifecycle Notifications ..
        + smarthire.tenant.provisioned
    }
}

' Relationships
TenantRetryRoute ..> MasterTenantController : defines route >
MasterTenantController ..> TenantAdminRequest : consumes >
MasterTenantController --> MasterTenantService : delegates >
MasterTenantController ..> TenantResponse : returns >

MasterTenantService <|.. MasterTenantServiceImpl : implements
MasterTenantServiceImpl ..> TenantAdminRequest : processes >
MasterTenantServiceImpl ..> TenantResponse : creates >
MasterTenantServiceImpl ..> TenantRetryCompletedEvent : emits >
MasterTenantServiceImpl --> TenantInfoRepository : queries & updates >
MasterTenantServiceImpl --> TenantProvisioningService : coordinates retry >
MasterTenantServiceImpl --> RabbitMQExchange : publishes completion event >

TenantProvisioningService <|.. TenantProvisioningServiceImpl : implements
TenantProvisioningServiceImpl --> MasterPostgreSQL : acquires advisory lock >
TenantProvisioningServiceImpl --> DedicatedTenantMySQL : runs Flyway & seeds admin >
TenantProvisioningServiceImpl ..> TenantUser : maintains admin entity >

TenantInfoRepository --> TenantInfo : manages >
TenantInfoRepository --> MasterPostgreSQL : persists to >
TenantInfo ..> TenantStatus : typed by >

DedicatedTenantMySQL *-- TenantUser : stores >

@enduml
