@startuml

skinparam dpi 300
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequenceArrowThickness 1
skinparam sequenceMessageAlign center
skinparam ArrowColor #64748B
skinparam ParticipantBorderColor #CBD5E1
skinparam ParticipantBackgroundColor #F8FAFC
skinparam ActorBorderColor #3B82F6
skinparam ActorBackgroundColor #EFF6FF
skinparam DatabaseBorderColor #94A3B8
skinparam DatabaseBackgroundColor #F8FAFC
hide footbox
autonumber

actor "Workspace Admin" as Admin
boundary "Master Admin UI" as UI
control "Spring Security" as Security
boundary "MasterTenantController" as Controller
control "MasterTenantService" as Service
database "TenantInfoRepository\n(Master DB)" as Repo

note over Admin,Security
  Directory listing & tenant detail require WORKSPACE_ADMIN JWT token.
  Tenant existence check is public to support candidate/recruiter portal routing.
end note

== Flow 1: Directory Listing  ==

Admin -> UI: Navigate to "View list tenant" tab
activate UI
UI -> Security: GET /api/v1/master/tenants
activate Security
Security -> Controller: Authorized request
activate Controller
deactivate Security

Controller -> Service: getAllTenants()
activate Service
Service -> Repo: findAll()
activate Repo
Repo --> Service: List<TenantInfo>
deactivate Repo
Service --> Controller: List<TenantInfo>
deactivate Service

Controller -> Controller: Map to List<TenantResponse>\n(sanitize credentials)
Controller --> UI: 200 OK with List<TenantResponse>
deactivate Controller
UI --> Admin: Render tenant directory table with status badges & filter controls
deactivate UI

== Flow 2: View Tenant Details  ==

Admin -> UI: Click "Chi tiết" (View Details) on a tenant row
activate UI
UI -> Security: GET /api/v1/master/tenants/{id}
activate Security
Security -> Controller: Authorized request
activate Controller
deactivate Security

Controller -> Service: getTenantById(id)
activate Service
Service -> Repo: findById(id)
activate Repo

alt Tenant not found
  Repo --> Service: Optional.empty()
  Service --> Controller: BusinessException(404, "TENANT_NOT_FOUND")
  Controller --> UI: 404 Not Found
  UI --> Admin: Show "Tenant không tồn tại" error
else Tenant found
  Repo --> Service: TenantInfo entity
  deactivate Repo
  Service --> Controller: TenantInfo entity
  deactivate Service

  Controller -> Controller: TenantResponse.from(entity)
  Controller --> UI: 200 OK with TenantResponse
  deactivate Controller
  UI --> Admin: Open modal displaying tenant ID, code, subdomain, dbName, status
  deactivate UI
end

== Flow 3: Realtime Existence Check (Kiểm tra định danh khả dụng / tồn tại) ==

Admin -> UI: Type tenant code or subdomain in search or onboarding form
activate UI
UI -> Controller: GET /api/v1/master/tenants/check/{codeOrSubdomain}
activate Controller
Controller -> Service: checkTenantExists(codeOrSubdomain)
activate Service

Service -> Repo: findByCode(val) OR findBySubdomain(val)
activate Repo
Repo --> Service: Optional<TenantInfo>
deactivate Repo

alt Tenant exists and status == 'ACTIVE'
  Service --> Controller: true
  Controller --> UI: 200 OK (exists: true)
  UI --> Admin: Indicate tenant exists and is active
else Tenant does not exist or status != 'ACTIVE'
  Service --> Controller: false
  Controller --> UI: 200 OK (exists: false)
  UI --> Admin: Indicate tenant code/subdomain is available or inactive
  deactivate Controller
  deactivate Service
  deactivate UI
end

@enduml
