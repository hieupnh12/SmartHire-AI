@startuml
title COMPANY-04 — Lock or Delete Member\nLayered target application-design viewpoint
top to bottom direction

skinparam dpi 300
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 12
skinparam linetype ortho
skinparam ArrowColor #334155
skinparam ArrowThickness 1
skinparam ClassBorderColor #64748B
skinparam ClassBorderThickness 1
skinparam ClassBackgroundColor #F8FAFC
skinparam InterfaceBackgroundColor #F3E8FF
skinparam PackageBorderColor #475569
skinparam PackageBorderThickness 1
skinparam DefaultFontColor #111827
skinparam ClassFontColor #111827
skinparam ClassAttributeFontColor #111827
skinparam NoteBackgroundColor #FFF7ED
skinparam NoteBorderColor #FDBA74

package "Routing & Boundary" #EFF6FF {
  class MemberLifecycleRoute <<REST API, conceptual>> {
    +PATCH /api/v1/tenant/users/{id}/status
    +DELETE /api/v1/tenant/users/{id}
  }
}

package "Controller Layer" #EFF6FF {
  class TenantUserController <<Controller>> {
    -tenantUserService: TenantUserService
    +updateStatus(id: Long, request: UpdateMemberStatusRequest): ApiResponse<UserResponse>
    +deleteMember(id: Long): void
  }
}

package "Service Layer" #F0FDF4 {
  class TenantUserService <<Service>> {
    -userRepository: UserRepository
    -tenantContext: TenantContext
    +updateStatus(actorId: Long, targetId: Long, status: UserStatus): UserResponse
    +deleteMember(actorId: Long, targetId: Long): void
  }
}

package "DTO Layer" #FFF7ED {
  class UpdateMemberStatusRequest <<Request, conceptual>> {
    +status: String
  }
  class UserResponse <<Response>> {
    +id: Long
    +email: String
    +fullName: String
    +role: String
    +status: String
  }
}

package "Repository Layer" #F5F3FF {
  interface UserRepository <<Repository>> {
    +findById(id: Long): Optional<User>
    +countByRoleAndStatus(role: UserRole, status: UserStatus): long
    +countJobOwnership(userId: Long): long
    +save(user: User): User
    +delete(user: User): void
  }
}

package "Domain Entity Layer" #F0FDF4 {
  entity User <<Entity>> {
    -id: Long
    -email: String
    -fullName: String
    -role: UserRole
    -status: UserStatus
  }
  enum UserRole <<enumeration>> {
    TENANT_ADMIN
    ADMIN
    HR
    RECRUITER
    CANDIDATE
  }
  enum UserStatus <<enumeration>> {
    ACTIVE
    LOCKED
    DISABLED
  }
}

package "Infrastructure & Persistence" #FEFCE8 {
  class RedisCache <<Cache>> {
    +refreshToken:{tenantId}:{userId}
  }
  class "Dedicated Tenant MySQL DB" as TenantDB <<Database>> {
    +users
  }
  class TenantContext <<ThreadLocal>> {
    +{static} getCurrentTenant(): String
    +{static} clear(): void
  }
}

MemberLifecycleRoute -down-> TenantUserController : defines routes
TenantUserController -down-> TenantUserService : delegates
TenantUserController ..> UpdateMemberStatusRequest : consumes
TenantUserController ..> UserResponse : returns
TenantUserService ..> UpdateMemberStatusRequest : processes
TenantUserService ..> UserResponse : creates
TenantUserService -down-> UserRepository : persists through
TenantUserService --> TenantContext : enforces tenant scope
TenantUserService --> RedisCache : revokes sessions
UserRepository -down-> User : manages
User --> UserRole : typed by
User --> UserStatus : typed by
User --> TenantDB : persists to

UpdateMemberStatusRequest -[hidden]right-> UserResponse
TenantDB -[hidden]right-> RedisCache
RedisCache -[hidden]right-> TenantContext

note right of UserStatus
  ACTIVE: can sign in.
  LOCKED: reversible block.
  DISABLED: soft delete when the user owns jobs.
  Hard delete only when job ownership is zero.
end note

note right of TenantUserService
  Actor cannot lock, unlock, or delete themselves.
  The last ACTIVE TENANT_ADMIN cannot be locked or deleted.
end note

@enduml
