@startuml
title COMPANY-05 — Verify Company\nLayered target application-design viewpoint
top to bottom direction

skinparam dpi 300
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 12
skinparam linetype ortho
skinparam ArrowColor #334155
skinparam ArrowThickness 1
skinparam ClassBorderColor #64748B
skinparam ClassBorderThickness 1
skinparam ClassBackgroundColor #F8FAFC
skinparam InterfaceBackgroundColor #F3E8FF
skinparam PackageBorderColor #475569
skinparam PackageBorderThickness 1
skinparam DefaultFontColor #111827
skinparam ClassFontColor #111827
skinparam ClassAttributeFontColor #111827
skinparam NoteBackgroundColor #FFF7ED
skinparam NoteBorderColor #FDBA74

package "Routing & Boundary" #EFF6FF {
  class TenantVerificationRoute <<REST API, conceptual>> {
    +POST /api/v1/tenant/company/verifications
  }
  class MasterVerificationRoute <<REST API, conceptual>> {
    +GET /api/v1/master/company-verifications
    +PATCH /api/v1/master/company-verifications/{id}
  }
}

package "Controller Layer" #EFF6FF {
  class TenantCompanyVerificationController <<Controller, conceptual>> {
    -companyVerificationService: CompanyVerificationService
    +submit(request: SubmitVerificationRequest): ApiResponse<VerificationResponse>
  }
  class MasterCompanyVerificationController <<Controller, conceptual>> {
    -companyVerificationService: CompanyVerificationService
    +list(status: String): ApiResponse<List<VerificationResponse>>
    +review(id: Long, request: ReviewVerificationRequest): ApiResponse<VerificationResponse>
  }
}

package "Service Layer" #F0FDF4 {
  class CompanyVerificationService <<Service, conceptual>> {
    -requestRepository: CompanyVerificationRequestRepository
    -tenantInfoRepository: TenantInfoRepository
    -objectStorage: ObjectStoragePort
    +submit(tenantId: String, request: SubmitVerificationRequest): VerificationResponse
    +review(reviewerId: Long, id: Long, request: ReviewVerificationRequest): VerificationResponse
  }
}

package "DTO Layer" #FFF7ED {
  class SubmitVerificationRequest <<Request, conceptual>> {
    +legalName: String
    +taxId: String
  }
  class ReviewVerificationRequest <<Request, conceptual>> {
    +decision: String
    +reviewNote: String [0..1]
  }
  class VerificationResponse <<Response, conceptual>> {
    +id: Long
    +tenantCode: String
    +legalName: String
    +status: String
    +reviewedAt: Instant [0..1]
  }
}

package "Repository Layer" #F5F3FF {
  interface CompanyVerificationRequestRepository <<Repository, conceptual>> {
    +findCurrentByTenantId(tenantId: Long): Optional<CompanyVerificationRequest>
    +save(request: CompanyVerificationRequest): CompanyVerificationRequest
  }
  interface TenantInfoRepository <<Repository>> {
    +findByCode(code: String): Optional<TenantInfo>
    +save(tenant: TenantInfo): TenantInfo
  }
}

package "Domain Entity Layer" #F0FDF4 {
  entity TenantInfo <<Entity>> {
    -id: Long
    -code: String
    -name: String
    -status: String
    -verificationStatus: VerificationStatus
  }
  entity CompanyVerificationRequest <<Entity, conceptual>> {
    -id: Long
    -tenantId: Long
    -legalName: String
    -taxId: String
    -documentKeys: String
    -status: VerificationStatus
    -reviewedBy: Long [0..1]
  }
  entity CompanyProfile <<Entity, conceptual>> {
    -name: String
    -address: String [0..1]
  }
  enum VerificationStatus <<enumeration, conceptual>> {
    UNVERIFIED
    PENDING
    VERIFIED
    REJECTED
  }
}

package "Infrastructure & Persistence" #FEFCE8 {
  interface ObjectStoragePort <<Storage Port, conceptual>> {
    +storeVerificationDocument(tenantId: String, file: MultipartFile): String
  }
  interface EmailNotificationProducer <<Messaging Port, conceptual>> {
    +publishVerificationReviewed(tenantId: String, decision: String): void
  }
  class "Master PostgreSQL" as MasterDB <<Database>> {
    +tenants
    +company_verification_requests
  }
  class "Dedicated Tenant MySQL DB" as TenantDB <<Database>> {
    +company_profiles
  }
  class TenantContext <<ThreadLocal>> {
    +{static} getCurrentTenant(): String
    +{static} clear(): void
  }
}

TenantVerificationRoute -down-> TenantCompanyVerificationController : defines routes
MasterVerificationRoute -down-> MasterCompanyVerificationController : defines routes
TenantCompanyVerificationController -down-> CompanyVerificationService : delegates
MasterCompanyVerificationController -down-> CompanyVerificationService : delegates
TenantCompanyVerificationController ..> SubmitVerificationRequest : consumes
MasterCompanyVerificationController ..> ReviewVerificationRequest : consumes
MasterCompanyVerificationController ..> VerificationResponse : returns
CompanyVerificationService ..> VerificationResponse : creates
CompanyVerificationService -down-> CompanyVerificationRequestRepository : persists through
CompanyVerificationService --> TenantInfoRepository : persists through
CompanyVerificationService --> ObjectStoragePort : stores evidence
CompanyVerificationService --> EmailNotificationProducer : notifies
CompanyVerificationService --> TenantContext : tenant submit scope
CompanyVerificationRequestRepository -down-> CompanyVerificationRequest : manages
TenantInfoRepository -down-> TenantInfo : manages
TenantInfo "1" o-- "0..*" CompanyVerificationRequest : has history
CompanyVerificationRequest --> VerificationStatus : typed by
TenantInfo --> VerificationStatus : typed by
TenantInfo --> MasterDB : persists to
CompanyVerificationRequest --> MasterDB : persists to
CompanyProfile --> TenantDB : persists to

SubmitVerificationRequest -[hidden]right-> ReviewVerificationRequest
MasterDB -[hidden]right-> TenantDB
TenantDB -[hidden]right-> TenantContext

note right of CompanyVerificationRequest
  Platform-owned KYC. tenantId is a Master registry key,
  not a FK into Tenant MySQL. Document bytes are not in DB.
  tenants.status stays operational; verificationStatus is designed.
end note

@enduml
