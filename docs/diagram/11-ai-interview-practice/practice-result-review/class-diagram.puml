@startuml
!include ../class-style.puml

package "Controller Layer" {
  class PracticeController <<Controller>> {
    - practiceService: PracticeService
    + listSessions(): ApiResponse<List<PracticeSessionSummary>>
    + getSession(id: Long): ApiResponse<PracticeSessionDetail>
    + getFeedback(id: Long): ApiResponse<PracticeFeedbackResponse>
    + deleteSession(id: Long): ApiResponse<Void>
  }
}

package "DTO Layer" {
  class PracticeSessionSummary <<Response>> {
    + id: Long
    + topic: String
    + status: PracticeStatus
    + score: Decimal [0..1]
    + createdAt: Instant
  }
  class PracticeSessionDetail <<Response>> {
    + id: Long
    + topic: String
    + status: PracticeStatus
    + answers: List<PracticeAnswerView>
    + feedback: PracticeFeedbackResponse [0..1]
  }
  class PracticeAnswerView <<Response>> {
    + questionText: String
    + questionType: PracticeQuestionType [0..1]
    + answerText: String [0..1]
  }
  class PracticeFeedbackResponse <<Response>> {
    + score: Decimal [0..1]
    + content: String
    + sections: List<SectionScore> [0..*]
  }
  class SectionScore <<DTO>> {
    + section: PracticeQuestionType
    + score: Decimal
    + tips: List<String>
  }
}

package "Service Layer" {
  interface PracticeService <<Service>> {
    + listMine(principal: Principal): List<PracticeSessionSummary>
    + getDetail(id: Long, principal: Principal): PracticeSessionDetail
    + getFeedback(id: Long, principal: Principal): PracticeFeedbackResponse
    + softDelete(id: Long, principal: Principal): void
  }
  class PracticeServiceImpl <<Service>> {
    - sessionRepository: PracticeSessionRepository
    - answerRepository: PracticeAnswerRepository
    - feedbackRepository: PracticeFeedbackRepository
    - tenantContext: TenantContext
    + listMine(principal: Principal): List<PracticeSessionSummary>
    + getDetail(id: Long, principal: Principal): PracticeSessionDetail
    + getFeedback(id: Long, principal: Principal): PracticeFeedbackResponse
    + softDelete(id: Long, principal: Principal): void
  }
}

package "Repository Layer" {
  interface PracticeSessionRepository <<Repository>> {
    + findAllByCandidate(candidateId: Long): List<PracticeSession>
    + findByIdAndCandidate(id: Long, candidateId: Long): Optional<PracticeSession>
    + softDelete(id: Long, candidateId: Long): void
  }
  interface PracticeAnswerRepository <<Repository>> {
    + findAllBySession(sessionId: Long): List<PracticeAnswer>
  }
  interface PracticeFeedbackRepository <<Repository>> {
    + findBySession(sessionId: Long): Optional<PracticeFeedback>
  }
}

package "Domain Entity Layer" {
  class PracticeSession <<Entity>> {
    - id: Long
    - topic: String
    - status: PracticeStatus
    - deletedAt: Instant [0..1]
  }
  class PracticeAnswer <<Entity>> {
    - id: Long
    - questionText: String
    - questionType: PracticeQuestionType [0..1]
    - answerText: String [0..1]
  }
  class PracticeFeedback <<Entity>> {
    - score: Decimal
    - content: String
    - breakdownJson: String [0..1]
  }
  enum PracticeStatus <<Enum>> {
    CREATED
    IN_PROGRESS
    COMPLETED
    FAILED
  }
  enum PracticeQuestionType <<Enum>> {
    GENERAL
    TECHNICAL
    BEHAVIORAL
    JAPANESE
  }
}

package "Infrastructure & Persistence" {
  class TenantMySQL <<Database>> {
    .. Dedicated Tenant DB ..
    + practice_sessions
    + practice_answers
    + practice_feedbacks
  }
  class TenantContext <<DataSource>> {
    + {static} getCurrentTenant(): String
    + {static} clear(): void
  }
}

PracticeController ..> PracticeSessionSummary : returns >
PracticeController ..> PracticeSessionDetail : returns >
PracticeController ..> PracticeFeedbackResponse : returns >
PracticeController --> PracticeService : delegates >
PracticeService <|.. PracticeServiceImpl : implements
PracticeServiceImpl ..> PracticeSessionSummary : creates >
PracticeServiceImpl ..> PracticeSessionDetail : creates >
PracticeServiceImpl ..> PracticeFeedbackResponse : creates >
PracticeServiceImpl --> PracticeSessionRepository : queries >
PracticeServiceImpl --> PracticeAnswerRepository : queries >
PracticeServiceImpl --> PracticeFeedbackRepository : queries >
PracticeServiceImpl --> TenantContext : caches / evicts >

PracticeSessionRepository --> PracticeSession : manages >
PracticeAnswerRepository --> PracticeAnswer : manages >
PracticeFeedbackRepository --> PracticeFeedback : manages >
PracticeSessionRepository --> TenantMySQL : persists to >
PracticeAnswerRepository --> TenantMySQL : reads from >
PracticeFeedbackRepository --> TenantMySQL : reads from >

PracticeSession "1" *-- "0..*" PracticeAnswer
PracticeSession "1" *-- "0..1" PracticeFeedback
PracticeSession ..> PracticeStatus : typed by >
PracticeAnswer ..> PracticeQuestionType : typed by >
PracticeFeedbackResponse ..> SectionScore : creates >
SectionScore ..> PracticeQuestionType : typed by >

note right of PracticeServiceImpl
  Read-only review + soft delete (owner only).
  No AI calls. Progress chart optional later.
  deletedAt is target design (PRACT-03).
end note
@enduml
