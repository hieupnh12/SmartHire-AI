@startuml
title FE11-F03 — Voice Practice & Speech-to-Text\nLayered target application-design viewpoint
top to bottom direction
skinparam dpi 300
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 12
skinparam linetype ortho
skinparam ArrowColor #334155
skinparam ArrowThickness 1
skinparam ClassBorderColor #64748B
skinparam ClassBorderThickness 1
skinparam ClassBackgroundColor #F8FAFC
skinparam InterfaceBackgroundColor #F3E8FF
skinparam PackageBorderColor #475569
skinparam PackageBorderThickness 1
skinparam DefaultFontColor #111827

package "Routing & Boundary" #EFF6FF {
  class PracticeVoiceRoute <<REST API, conceptual>> {
    +POST /api/v1/practice/sessions/{id}/voice
  }
}

package "Controller Layer" #EFF6FF {
  class PracticeController <<Controller>> {
    -practiceService: PracticeService
    +submitVoice(sessionId: Long, request: PracticeVoiceRequest): ApiResponse<VoiceAcceptedResponse>
  }
}

package "Service Layer" #F0FDF4 {
  class PracticeService <<Service>> {
    -sessionRepository: PracticeSessionRepository
    -answerRepository: PracticeAnswerRepository
    -objectStorage: ObjectStoragePort
    -sttPublisher: PracticeSttPublisher
    +submitVoiceAnswer(...): VoiceAcceptedResponse
  }
  class PracticeSttService <<Service>> {
    -answerRepository: PracticeAnswerRepository
    -sttPort: SpeechToTextPort
    +transcribe(job: PracticeSttJob): PracticeAnswer
  }
  class PracticeSttConsumer <<RabbitMQ Consumer>> {
    -sttService: PracticeSttService
    +onStt(job: PracticeSttJob, tenantId: String): void
  }
}

package "DTO Layer" #FFF7ED {
  class PracticeVoiceRequest <<Request>> {
    +answerId: Long
    +audio: MultipartFile
    +language: String
  }
  class VoiceAcceptedResponse <<Response>> {
    +sessionId: Long
    +answerId: Long
    +accepted: boolean
  }
  class PracticeSttJob <<Message>> {
    +sessionId: Long
    +answerId: Long
    +language: String
  }
}

package "Repository Layer" #F5F3FF {
  interface PracticeSessionRepository <<Repository>>
  interface PracticeAnswerRepository <<Repository>>
}

package "Domain Entity Layer" #F0FDF4 {
  entity PracticeSession <<Entity>> {
    -id: Long
    -status: PracticeStatus
  }
  entity PracticeAnswer <<Entity>> {
    -id: Long
    -questionText: String
    -answerText: String [0..1]
    -audioUrl: String [0..1]
    -status: String
  }
}

package "Infrastructure & Persistence" #FEFCE8 {
  interface ObjectStoragePort <<Storage Port>>
  interface SpeechToTextPort <<STT Port>>
  class PracticeSttPublisher <<Publisher>>
  class "RabbitMQ\npractice.stt" as MQ <<Message Broker>>
  class "Dedicated Tenant MySQL DB" as TenantDB <<Database>>
  class TenantContext <<ThreadLocal>>
}

PracticeVoiceRoute -down-> PracticeController : defines routes
PracticeController -down-> PracticeService : delegates
PracticeService --> ObjectStoragePort : stores audio
PracticeService --> PracticeSttPublisher : publishes
PracticeSttPublisher --> MQ : X-Tenant-ID
MQ --> PracticeSttConsumer : delivers
PracticeSttConsumer --> PracticeSttService : processes
PracticeSttService --> SpeechToTextPort : transcribes
PracticeSttService --> PracticeAnswerRepository : saves transcript
PracticeSession "1" *-- "0..*" PracticeAnswer : contains

note right of PracticeSttService
  Reuses SpeechToTextPort (pattern FE08-F02).
  Writes practice_answers only.
  Analysis/feedback is FE11-F04.
end note

note bottom of MQ
  Target queue practice.stt (not in yml yet).
end note
@enduml
