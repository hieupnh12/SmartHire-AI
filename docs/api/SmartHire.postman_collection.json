{
  "info": {
    "name": "SmartHire-AI API",
    "description": "Skeleton Postman collection. Prefer regenerating from Swagger `/v3/api-docs` once the backend is running. Async AI endpoints publish to RabbitMQ.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "candidateToken", "value": "" },
    { "key": "questionId", "value": "1" },
    { "key": "optionId", "value": "1" },
    { "key": "submissionId", "value": "1" },
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "tenantId",
      "value": "acme"
    },
    {
      "key": "jobId",
      "value": "1"
    },
    {
      "key": "testId",
      "value": "1"
    },
    {
      "key": "applicationId",
      "value": "1"
    },
    {
      "key": "masterToken",
      "value": ""
    },
    {
      "key": "tenantRecordId",
      "value": "1"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.test"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "masterEmail",
      "value": ""
    },
    {
      "key": "masterPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Technical Assessment - Questions and Submissions",
      "description": "Staff uses accessToken; candidate uses candidateToken in the same tenant. Create a JobTest first. Use returned IDs. Publish before start. Application must belong to the candidate and test job, at ASSESSMENT or INTERVIEW.",
      "item": [
        {
          "name": "Create question with options",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/assessments/{{testId}}/questions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionText\": \"Which keyword defines a Java class?\",\n  \"points\": 5,\n  \"questionOrder\": 0,\n  \"options\": [\n    {\n      \"optionText\": \"class\",\n      \"correct\": true\n    },\n    {\n      \"optionText\": \"def\",\n      \"correct\": false\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List questions (staff)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/assessments/{{testId}}/questions"
          }
        },
        {
          "name": "Replace question and options (new option IDs)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/assessments/{{testId}}/questions/{{questionId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionText\": \"Which keyword defines a Java class?\",\n  \"points\": 5,\n  \"questionOrder\": 0,\n  \"options\": [\n    {\n      \"optionText\": \"class\",\n      \"correct\": true\n    },\n    {\n      \"optionText\": \"def\",\n      \"correct\": false\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete draft question",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/assessments/{{testId}}/questions/{{questionId}}"
          }
        },
        {
          "name": "Publish MCQ test",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/assessments/{{testId}}/publish"
          }
        },
        {
          "name": "Start or resume own submission",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{candidateToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/assessments/{{testId}}/submissions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicationId\": {{applicationId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get own paper and timer",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{candidateToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/submissions/{{submissionId}}"
          }
        },
        {
          "name": "Save answers",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{candidateToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/submissions/{{submissionId}}/answers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [{ \"questionId\": {{questionId}}, \"selectedOptionId\": {{optionId}} }]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Clear one answer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{candidateToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/submissions/{{submissionId}}/answers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [{ \"questionId\": {{questionId}}, \"selectedOptionId\": null }]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Submit saved answers",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{candidateToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/submissions/{{submissionId}}/submit"
          }
        },
        {
          "name": "Inspect submission (staff)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/submissions/{{submissionId}}/result"
          }
        }
      ]
    },
    {
      "name": "Technical Assessment - JobTest",
      "item": [
        {
          "name": "Create draft test",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/assessments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobId\": {{jobId}},\n  \"title\": \"Java basics\",\n  \"description\": \"Java assessment\",\n  \"durationMinutes\": 30,\n  \"passingScore\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List tests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/assessments?page=0&size=20"
          }
        },
        {
          "name": "Get test",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/assessments/{{testId}}"
          }
        },
        {
          "name": "Update draft test",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/assessments/{{testId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobId\": {{jobId}},\n  \"title\": \"Java basics\",\n  \"description\": \"Java assessment\",\n  \"durationMinutes\": 30,\n  \"passingScore\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"recruiter@example.com\",\n  \"password\": \"Secret123!\",\n  \"fullName\": \"Jane Doe\",\n  \"role\": \"RECRUITER\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"recruiter@example.com\",\n  \"password\": \"Secret123!\"\n}"
            }
          }
        },
        {
          "name": "Google Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/google",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"<google-id-token>\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Create Job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/jobs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Backend Engineer\",\n  \"description\": \"Spring Boot, MySQL\",\n  \"location\": \"Ho Chi Minh\",\n  \"employmentType\": \"FULL_TIME\"\n}"
            }
          }
        },
        {
          "name": "Close Job",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/jobs/1/close"
          }
        }
      ]
    },
    {
      "name": "CV Screening",
      "item": [
        {
          "name": "Upload CV",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/cvs",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "jobId",
                  "value": "1",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Delete CV",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/cvs/1"
          }
        },
        {
          "name": "Analyze CV (async RabbitMQ)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/cvs/1/analyze"
          }
        }
      ]
    },
    {
      "name": "AI Interview",
      "item": [
        {
          "name": "Generate Questions (async RabbitMQ)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/interviews/1/questions/generate"
          }
        },
        {
          "name": "AI Scoring (async RabbitMQ)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/interviews/1/score"
          }
        }
      ]
    },
    {
      "name": "Candidate Ranking",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{accessToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Owned jobs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/rankings/jobs"
          }
        },
        {
          "name": "Current ranking board",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/jobs/{{jobId}}/rankings"
          }
        },
        {
          "name": "Recompute snapshots",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/jobs/{{jobId}}/rankings/recompute"
          }
        },
        {
          "name": "Save weights (use current revision and job categories)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/jobs/{{jobId}}/rankings/config",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"weights\": {\"skills\": 35, \"experience\": 15, \"assessment\": 30, \"interview\": 20},\n  \"groups\": {\"backend\": 100},\n  \"requiredExperienceMonths\": 24,\n  \"revision\": 0\n}"
            }
          }
        },
        {
          "name": "Overall score and evidence",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/applications/{{applicationId}}/overall-score"
          }
        },
        {
          "name": "Available official sources",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/applications/{{applicationId}}/ranking-sources"
          }
        },
        {
          "name": "Select official sources (null selects only a unique source)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/applications/{{applicationId}}/ranking-sources",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cvId\": null,\n  \"attemptId\": null,\n  \"interviewId\": null\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/dashboard/summary"
          }
        }
      ]
    },
    {
      "name": "Master and Tenant Provisioning",
      "item": [
        {
          "name": "Master Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/master/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{masterEmail}}\",\n  \"password\": \"{{masterPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set(\"masterToken\", pm.response.json().data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Onboard Tenant (automatic)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{masterToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/master/tenants/onboard",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{tenantId}}\",\n  \"name\": \"Company\",\n  \"subdomain\": \"{{tenantId}}\",\n  \"adminName\": \"Tenant Admin\",\n  \"adminEmail\": \"{{adminEmail}}\",\n  \"adminPassword\": \"{{adminPassword}}\"\n}"
            }
          }
        },
        {
          "name": "List Tenants",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{masterToken}}"
              }
            ],
            "url": "{{baseUrl}}/master/tenants"
          }
        },
        {
          "name": "Retry Tenant Provisioning",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{masterToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/master/tenants/{{tenantRecordId}}/retry",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"adminName\": \"Tenant Admin\",\n  \"adminEmail\": \"{{adminEmail}}\",\n  \"adminPassword\": \"{{adminPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Suspend Tenant",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{masterToken}}"
              }
            ],
            "url": "{{baseUrl}}/master/tenants/{{tenantRecordId}}/status?status=SUSPENDED"
          }
        },
        {
          "name": "Activate Tenant",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{masterToken}}"
              }
            ],
            "url": "{{baseUrl}}/master/tenants/{{tenantRecordId}}/status?status=ACTIVE"
          }
        },
        {
          "name": "Tenant Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tenant/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set(\"accessToken\", pm.response.json().data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
