  "item": [
    {
      "name": "AI Interview candidate invitations",
      "item": [
        {
          "name": "Danh sách lời mời của candidate",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{candidateToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ai-interviews/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ai-interviews",
                "me"
              ]
            }
          }
        },
        {
          "name": "Chi tiết AI Interview",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{candidateToken}}"
