    {
      "name": "Technical Assessment - Questions and Submissions",
      "description": "Staff uses accessToken; candidate uses candidateToken in the same tenant. Create a JobTest first. Use returned IDs. Publish before start. Application must belong to the candidate and test job, at ASSESSMENT or INTERVIEW.",
      "item": [
        {
          "name": "Create question with options",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/assessments/{{testId}}/create_question",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionText\": \"Which keyword defines a Java class?\",\n  \"points\": 5,\n  \"questionOrder\": 0,\n  \"options\": [\n    {\n      \"optionText\": \"class\",\n      \"correct\": true\n    },\n    {\n      \"optionText\": \"def\",\n      \"correct\": false\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List questions (staff)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/assessments/{{testId}}/list_questions"
          }
        },
        {
          "name": "Replace question and options (new option IDs)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/assessments/{{testId}}/update_question/{{questionId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionText\": \"Which keyword defines a Java class?\",\n  \"points\": 5,\n  \"questionOrder\": 0,\n  \"options\": [\n    {\n      \"optionText\": \"class\",\n      \"correct\": true\n    },\n    {\n      \"optionText\": \"def\",\n      \"correct\": false\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete draft question",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/assessments/{{testId}}/delete_question/{{questionId}}"
          }
        },
        {
          "name": "Publish MCQ test",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/assessments/{{testId}}/publish_test"
          }
        },
        {
          "name": "Start or resume own submission",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{candidateToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/assessments/{{testId}}/start_submission",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicationId\": {{applicationId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get own paper and timer",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{candidateToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/submissions/{{submissionId}}/get_submission"
          }
        },
        {
          "name": "Save answers",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{candidateToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/submissions/{{submissionId}}/save_answers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [{ \"questionId\": {{questionId}}, \"selectedOptionId\": {{optionId}} }]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Clear one answer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{candidateToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/submissions/{{submissionId}}/save_answers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [{ \"questionId\": {{questionId}}, \"selectedOptionId\": null }]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Submit saved answers",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{candidateToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/submissions/{{submissionId}}/submit_test"
          }
        },
        {
          "name": "Inspect submission (staff)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/submissions/{{submissionId}}/get_result"
          }
        },
        {
          "name": "List job submissions (staff)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/jobs/{{jobId}}/list_assessment_submissions"
          }
        }
      ]
    },
