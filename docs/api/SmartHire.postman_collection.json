              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ai-interviews/{{aiInterviewId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ai-interviews",
                "{{aiInterviewId}}"
              ]
            }
          }
        },
        {
          "name": "Bắt đầu AI Interview",
