# Load these variables in your shell/IDE, or pass --env-file backend/.env to Docker Compose.
# Spring Boot does not automatically read this .env file.
MASTER_DB_URL=jdbc:postgresql://localhost:5432/smarthire_master
MASTER_DB_USERNAME=smarthire_master
MASTER_DB_PASSWORD=CHANGE_ME_master_password
MASTER_DB_POOL_SIZE=10
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password
TENANT_MYSQL_BASE_URL=jdbc:mysql://localhost:3306
TENANT_MYSQL_OPTIONS='sslMode=PREFERRED&allowPublicKeyRetrieval=true'
TENANT_PROVISIONING_URL=jdbc:mysql://localhost:3306/?allowPublicKeyRetrieval=true
TENANT_PROVISIONING_USERNAME=smarthire_provisioner
# Generate a hex password: openssl rand -hex 24
TENANT_PROVISIONING_PASSWORD=CHANGE_ME_HEX_PASSWORD
# Generate exactly 32 random bytes: openssl rand -base64 32
TENANT_CREDENTIALS_KEY=CHANGE_ME_BASE64_32_BYTES
TENANT_BASE_DOMAIN=smarthire.top
TENANT_DB_POOL_SIZE=5
TENANT_MAX_POOLS=20
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
RABBIT_CONCURRENCY=3
RABBIT_MAX_CONCURRENCY=10
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# Generate a strong secret: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_RANDOM_SECRET
CORS_ORIGINS=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail SMTP: enable 2FA and use an App Password. Leave blank to skip sending (invite still returns acceptUrl).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
INVITE_PUBLIC_ORIGIN=http://localhost:5173
# Spring Boot does not automatically read this .env file. For local CV AI:
#   $env:GEMINI_API_KEY="your-key"
#   $env:JAVA_HOME="C:\Program Files\Eclipse Adoptium\jdk-21.0.12.101-hotspot"
#   .\mvnw.cmd spring-boot:run
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CV_MAX_FILE_BYTES=10485760
# Required. Cloudinary — CV files are not stored on local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
